<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_contract_amendment_tree" model="ir.ui.view">
        <field name="name">property.contract.amendment.list</field>
        <field name="model">property.contract.amendment</field>
        <field name="arch" type="xml">
            <list decoration-success="status == 'applied'" decoration-warning="status in ('signed','ready_to_apply')" decoration-muted="status in ('cancelled','archived')">
                <field name="sequence"/>
                <field name="contract_id"/>
                <field name="amendment_number"/>
                <field name="name"/>
                <field name="amendment_type"/>
                <field name="amendment_reason_id"/>
                <field name="effective_date"/>
                <field name="sign_date"/>
                <field name="billing_impact_count"/>
                <field name="billing_impact_total_delta"/>
                <field name="status"/>
                <field name="is_applied"/>
            </list>
        </field>
    </record>

    <record id="view_property_contract_amendment_form" model="ir.ui.view">
        <field name="name">property.contract.amendment.form</field>
        <field name="model">property.contract.amendment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit_legal" type="object" string="Enviar Jurídico" class="oe_highlight" invisible="status != 'draft'"/>
                    <button name="action_approve" type="object" string="Aprovar" invisible="status not in ('legal_review','commercial_review','financial_review','risk_review')"/>
                    <button name="action_send_to_signature" type="object" string="Enviar Assinatura" invisible="status != 'approved'"/>
                    <button name="action_mark_signed" type="object" string="Marcar Assinado" invisible="status not in ('sent_to_signature','partially_signed','approved')"/>
                    <button name="action_ready_to_apply" type="object" string="Pronto para Aplicar" invisible="status != 'signed'"/>
                    <button name="action_simulate_billing_impact" type="object" string="Simular Parcelas" invisible="not requires_billing_recalculation and not financial_impact"/>
                    <button name="action_apply_billing_impact" type="object" string="Aplicar Parcelas" invisible="not has_pending_billing_impacts"/>
                    <button name="action_reverse_billing_impact" type="object" string="Reverter Parcelas" invisible="not billing_impact_count or status == 'cancelled'"/>
                    <button name="action_apply" type="object" string="Aplicar ao Contrato" class="oe_highlight" invisible="status not in ('signed','ready_to_apply','approved') or is_applied"/>
                    <button name="action_cancel" type="object" string="Cancelar" invisible="status in ('applied','cancelled','archived')"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,legal_review,approved,signed,ready_to_apply,applied"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="contract_id"/>
                            <field name="amendment_number"/>
                            <field name="amendment_type"/>
                            <field name="amendment_reason_id"/>
                            <field name="amendment_scope"/>
                            <field name="economic_effect"/>
                            <field name="risk_level"/>
                        </group>
                        <group>
                            <field name="instrument_date"/>
                            <field name="sign_date"/>
                            <field name="signature_completed_at"/>
                            <field name="effective_date"/>
                            <field name="retroactive_effect"/>
                            <field name="signature_method"/>
                            <field name="is_applied" readonly="1"/>
                            <field name="billing_impact_count" readonly="1"/>
                            <field name="billing_impact_total_delta" readonly="1"/>
                            <field name="has_pending_billing_impacts" readonly="1"/>
                        </group>
                    </group>
                    <group string="Impactos">
                        <field name="commercial_impact"/>
                        <field name="financial_impact"/>
                        <field name="legal_impact"/>
                        <field name="operational_impact"/>
                        <field name="requires_financial_update"/>
                        <field name="requires_party_update"/>
                        <field name="requires_term_update"/>
                        <field name="requires_guarantee_update"/>
                        <field name="requires_asset_update"/>
                        <field name="requires_billing_recalculation"/>
                        <field name="requires_accounting_adjustment"/>
                    </group>
                    <notebook>
                        <page string="Resumo">
                            <field name="summary_html"/>
                            <field name="legal_basis"/>
                            <field name="clauses_affected"/>
                            <field name="unchanged_clauses_html"/>
                        </page>
                        <page string="Alterações">
                            <field name="change_line_ids">
                                <list editable="bottom">
                                    <field name="sequence"/>
                                    <field name="field_key"/>
                                    <field name="change_category" readonly="1"/>
                                    <field name="field_name" invisible="1"/>
                                    <field name="field_label" invisible="1"/>
                                    <field name="value_type" readonly="1"/>
                                    <field name="old_value_char"/>
                                    <field name="new_value_char"/>
                                    <field name="old_value_float"/>
                                    <field name="new_value_float"/>
                                    <field name="old_value_date"/>
                                    <field name="new_value_date"/>
                                    <field name="old_value_partner_id"/>
                                    <field name="new_value_partner_id"/>
                                    <field name="effective_date"/>
                                    <field name="is_applied"/>
                                </list>
                            </field>
                        </page>
                        <page string="Impacto Financeiro">
                            <group string="Tabela de Valores">
                                <field name="rent_schedule_ids" nolabel="1"/>
                            </group>
                            <group string="Ajustes Financeiros Retroativos ou Complementares">
                                <field name="financial_adjustment_ids" nolabel="1"/>
                            </group>
                        </page>
                        <page string="Parcelas Afetadas">
                            <field name="billing_impact_ids" context="{'default_amendment_id': id}">
                                <list editable="bottom" decoration-success="status == 'applied'" decoration-warning="status == 'simulated'" decoration-danger="delta_amount &lt; 0" decoration-info="delta_amount &gt; 0">
                                    <field name="status"/>
                                    <field name="billing_plan_id"/>
                                    <field name="created_billing_plan_id"/>
                                    <field name="period_start"/>
                                    <field name="period_end"/>
                                    <field name="due_date"/>
                                    <field name="billing_status"/>
                                    <field name="impact_type"/>
                                    <field name="application_rule"/>
                                    <field name="original_amount"/>
                                    <field name="new_amount"/>
                                    <field name="delta_amount"/>
                                    <field name="is_retroactive"/>
                                </list>
                            </field>
                        </page>
                        <page string="Documentos"><field name="document_ids"/></page>
                        <page string="Aprovações"><field name="approval_ids"/></page>
                        <page string="Histórico"><field name="term_history_ids"/></page>
                        <page string="JSON"><field name="changes_json"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_property_contract_amendment" model="ir.actions.act_window">
        <field name="name">Aditivos</field>
        <field name="res_model">property.contract.amendment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
