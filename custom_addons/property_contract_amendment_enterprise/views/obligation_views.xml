<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_contract_obligation_tree" model="ir.ui.view">
        <field name="name">property.contract.obligation.list</field>
        <field name="model">property.contract.obligation</field>
        <field name="arch" type="xml"><list><field name="contract_id"/><field name="amendment_id"/><field name="obligation_type"/><field name="responsible_party"/><field name="name"/><field name="due_date"/><field name="status"/></list></field>
    </record>
    <record id="view_property_contract_obligation_form" model="ir.ui.view">
        <field name="name">property.contract.obligation.form</field>
        <field name="model">property.contract.obligation</field>
        <field name="arch" type="xml"><form><sheet><group><field name="contract_id"/><field name="amendment_id"/><field name="obligation_type"/><field name="responsible_party"/><field name="name"/><field name="due_date"/><field name="status"/></group></sheet><chatter/></form></field>
    </record>
    <record id="action_property_contract_obligation" model="ir.actions.act_window">
        <field name="name">Obrigações</field>
        <field name="res_model">property.contract.obligation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
