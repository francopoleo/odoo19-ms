<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_contract_billing_plan_tree" model="ir.ui.view">
        <field name="name">property.contract.billing.plan.list</field>
        <field name="model">property.contract.billing.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="contract_id"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="due_date"/>
                <field name="base_rent_amount"/>
                <field name="discount_amount"/>
                <field name="extra_charge_amount"/>
                <field name="total_amount"/>
                <field name="has_amendment_adjustment"/>
                <field name="amendment_delta_amount"/>
                <field name="amended_total_amount"/>
                <field name="status"/>
            </list>
        </field>
    </record>
    <record id="view_property_contract_billing_plan_form" model="ir.ui.view">
        <field name="name">property.contract.billing.plan.form</field>
        <field name="model">property.contract.billing.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="contract_id"/>
                        <field name="period_start"/>
                        <field name="period_end"/>
                        <field name="due_date"/>
                        <field name="status"/>
                        <field name="invoice_id"/>
                    </group>
                    <group string="Composição Atual">
                        <field name="base_rent_amount"/>
                        <field name="discount_amount"/>
                        <field name="extra_charge_amount"/>
                        <field name="tax_amount"/>
                        <field name="total_amount"/>
                    </group>
                    <group string="Auditoria de Aditivos">
                        <field name="has_amendment_adjustment" readonly="1"/>
                        <field name="original_total_amount" readonly="1"/>
                        <field name="amendment_delta_amount" readonly="1"/>
                        <field name="amended_total_amount" readonly="1"/>
                        <field name="amendment_effective_date" readonly="1"/>
                        <field name="amendment_applied_date" readonly="1"/>
                        <field name="source_amendment_ids" widget="many2many_tags"/>
                    </group>
                    <notebook>
                        <page string="Linhas de Cobrança">
                            <field name="line_ids"/>
                        </page>
                        <page string="Ajustes por Aditivo">
                            <field name="amendment_adjustment_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_property_contract_billing_plan" model="ir.actions.act_window">
        <field name="name">Plano de Cobrança</field>
        <field name="res_model">property.contract.billing.plan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
