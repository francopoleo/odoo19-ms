<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_contract_option_tree" model="ir.ui.view">
        <field name="name">property.contract.option.list</field>
        <field name="model">property.contract.option</field>
        <field name="arch" type="xml"><list><field name="contract_id"/><field name="amendment_id"/><field name="option_type"/><field name="name"/><field name="notice_deadline"/><field name="exercise_deadline"/><field name="status"/></list></field>
    </record>
    <record id="view_property_contract_option_form" model="ir.ui.view">
        <field name="name">property.contract.option.form</field>
        <field name="model">property.contract.option</field>
        <field name="arch" type="xml"><form><sheet><group><field name="contract_id"/><field name="amendment_id"/><field name="option_type"/><field name="name"/><field name="notice_deadline"/><field name="exercise_deadline"/><field name="status"/></group></sheet><chatter/></form></field>
    </record>
    <record id="action_property_contract_option" model="ir.actions.act_window">
        <field name="name">Opções</field>
        <field name="res_model">property.contract.option</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
