<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_contract_document_tree" model="ir.ui.view">
        <field name="name">property.contract.document.list</field>
        <field name="model">property.contract.document</field>
        <field name="arch" type="xml"><list><field name="contract_id"/><field name="amendment_id"/><field name="name"/><field name="document_type"/><field name="signature_provider"/><field name="envelope_id"/><field name="signature_status"/><field name="is_final"/></list></field>
    </record>
    <record id="view_property_contract_document_form" model="ir.ui.view">
        <field name="name">property.contract.document.form</field>
        <field name="model">property.contract.document</field>
        <field name="arch" type="xml"><form><sheet><group><field name="contract_id"/><field name="amendment_id"/><field name="name"/><field name="document_type"/><field name="signature_provider"/><field name="envelope_id"/><field name="signature_status"/><field name="is_final"/></group></sheet><chatter/></form></field>
    </record>
    <record id="action_property_contract_document" model="ir.actions.act_window">
        <field name="name">Documentos</field>
        <field name="res_model">property.contract.document</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
