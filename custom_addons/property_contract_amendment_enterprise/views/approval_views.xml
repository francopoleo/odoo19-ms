<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_contract_approval_tree" model="ir.ui.view">
        <field name="name">property.contract.approval.list</field>
        <field name="model">property.contract.approval</field>
        <field name="arch" type="xml"><list><field name="contract_id"/><field name="amendment_id"/><field name="approval_type"/><field name="approver_id"/><field name="status"/><field name="approved_at"/></list></field>
    </record>
    <record id="view_property_contract_approval_form" model="ir.ui.view">
        <field name="name">property.contract.approval.form</field>
        <field name="model">property.contract.approval</field>
        <field name="arch" type="xml"><form><sheet><group><field name="contract_id"/><field name="amendment_id"/><field name="approval_type"/><field name="approver_id"/><field name="status"/><field name="approved_at"/></group></sheet><chatter/></form></field>
    </record>
    <record id="action_property_contract_approval" model="ir.actions.act_window">
        <field name="name">Aprovações</field>
        <field name="res_model">property.contract.approval</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
