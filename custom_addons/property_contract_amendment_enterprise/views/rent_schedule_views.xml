<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_contract_rent_schedule_tree" model="ir.ui.view">
        <field name="name">property.contract.rent.schedule.list</field>
        <field name="model">property.contract.rent.schedule</field>
        <field name="arch" type="xml">
            <list decoration-success="status == 'active'" decoration-muted="status in ('cancelled','superseded')">
                <field name="contract_id"/>
                <field name="name"/>
                <field name="charge_type"/>
                <field name="financial_reason_id"/>
                <field name="amount"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="status"/>
            </list>
        </field>
    </record>
    <record id="view_property_contract_rent_schedule_form" model="ir.ui.view">
        <field name="name">property.contract.rent.schedule.form</field>
        <field name="model">property.contract.rent.schedule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="contract_id"/>
                            <field name="amendment_id"/>
                            <field name="name"/>
                            <field name="charge_type"/>
                            <field name="financial_reason_id"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="amount_type"/>
                            <field name="amount"/>
                            <field name="percentage"/>
                            <field name="base_amount"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <group string="Cobrança">
                        <field name="due_day"/>
                        <field name="billing_frequency"/>
                        <field name="billing_period_type"/>
                        <field name="is_base_rent"/>
                        <field name="is_discount"/>
                        <field name="is_extra_charge"/>
                        <field name="is_temporary"/>
                        <field name="is_recurring"/>
                        <field name="is_retroactive"/>
                        <field name="is_proratable"/>
                        <field name="proration_method"/>
                    </group>
                    <group string="Contabilidade">
                        <field name="tax_included"/>
                        <field name="account_id"/>
                        <field name="analytic_account_id"/>
                    </group>
                    <field name="notes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_property_contract_rent_schedule" model="ir.actions.act_window">
        <field name="name">Tabela de Valores</field>
        <field name="res_model">property.contract.rent.schedule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
