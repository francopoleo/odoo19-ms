<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_contract_financial_adjustment_tree" model="ir.ui.view">
        <field name="name">property.contract.financial.adjustment.list</field>
        <field name="model">property.contract.financial.adjustment</field>
        <field name="arch" type="xml">
            <list>
                <field name="contract_id"/>
                <field name="amendment_id"/>
                <field name="adjustment_type"/>
                <field name="name"/>
                <field name="amount"/>
                <field name="reference_period_start"/>
                <field name="reference_period_end"/>
                <field name="apply_method"/>
                <field name="status"/>
            </list>
        </field>
    </record>
    <record id="view_property_contract_financial_adjustment_form" model="ir.ui.view">
        <field name="name">property.contract.financial.adjustment.form</field>
        <field name="model">property.contract.financial.adjustment</field>
        <field name="arch" type="xml"><form><sheet><group><field name="contract_id"/><field name="amendment_id"/><field name="adjustment_type"/><field name="financial_reason_id"/><field name="name"/><field name="amount"/><field name="reference_period_start"/><field name="reference_period_end"/><field name="apply_method"/><field name="status"/></group><field name="notes"/></sheet><chatter/></form></field>
    </record>
    <record id="action_property_contract_financial_adjustment" model="ir.actions.act_window">
        <field name="name">Ajustes Financeiros</field>
        <field name="res_model">property.contract.financial.adjustment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
