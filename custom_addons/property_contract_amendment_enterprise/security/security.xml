<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==================== PRIVILEGE ==================== -->
    <record id="privilege_contract_amendment" model="res.groups.privilege">
        <field name="name">Aditivos Contratuais</field>
        <field name="sequence" eval="20"/>
        <field name="category_id" ref="common_base.module_category_realestate"/>
    </record>

    <!-- ==================== GROUPS ==================== -->
    <record id="group_property_contract_amendment_user" model="res.groups">
        <field name="name">Aditivos Contratuais / Usuário</field>
        <field name="privilege_id" ref="property_contract_amendment_enterprise.privilege_contract_amendment"/>
    </record>
    <record id="group_property_contract_amendment_manager" model="res.groups">
        <field name="name">Aditivos Contratuais / Gestor</field>
        <field name="privilege_id" ref="property_contract_amendment_enterprise.privilege_contract_amendment"/>
        <field name="implied_ids" eval="[(4, ref('group_property_contract_amendment_user'))]"/>
    </record>
    <record id="group_property_contract_legal_manager" model="res.groups">
        <field name="name">Contratos / Jurídico</field>
        <field name="privilege_id" ref="property_contract_amendment_enterprise.privilege_contract_amendment"/>
        <field name="implied_ids" eval="[(4, ref('group_property_contract_amendment_user'))]"/>
    </record>
    <record id="group_property_contract_financial_manager" model="res.groups">
        <field name="name">Contratos / Financeiro</field>
        <field name="privilege_id" ref="property_contract_amendment_enterprise.privilege_contract_amendment"/>
        <field name="implied_ids" eval="[(4, ref('group_property_contract_amendment_user'))]"/>
    </record>
    <record id="group_property_contract_admin" model="res.groups">
        <field name="name">Contratos / Administrador</field>
        <field name="privilege_id" ref="property_contract_amendment_enterprise.privilege_contract_amendment"/>
        <field name="implied_ids" eval="[(4, ref('group_property_contract_amendment_manager'))]"/>
    </record>
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('property_contract_amendment_enterprise.group_property_contract_amendment_user'))]"/>
    </record>
</odoo>
