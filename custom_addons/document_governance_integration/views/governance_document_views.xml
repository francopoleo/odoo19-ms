<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_governance_case_form_documents_ext" model="ir.ui.view">
        <field name="name">governance.case.form.documents.ext</field>
        <field name="model">governance.case</field>
        <field name="inherit_id" ref="governance.view_governance_case_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_documents" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="status == 'closed'">
                    <field name="document_count" widget="statinfo" string="Documentos"/>
                </button>
                <button name="action_new_document" type="object" class="oe_stat_button" icon="fa-plus" invisible="id == False or status == 'closed'">
                    <span>Novo Documento</span>
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_document_document_form_governance_ext" model="ir.ui.view">
        <field name="name">document.document.form.governance.ext</field>
        <field name="model">document.document</field>
        <field name="inherit_id" ref="document_core.view_document_document_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='access_level']" position="after">
                <field name="case_id" options="{'no_create_edit': True}"/>
                <field name="governance_reference" readonly="1" invisible="not case_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_document_document_search_governance_ext" model="ir.ui.view">
        <field name="name">document.document.search.governance.ext</field>
        <field name="model">document.document</field>
        <field name="inherit_id" ref="document_core.view_document_document_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='access_level']" position="after">
                <field name="case_id"/>
            </xpath>
            <xpath expr="//filter[@name='group_access']" position="after">
                <filter string="Agrupar por Caso de Governança" name="group_governance_case" context="{'group_by': 'case_id'}"/>
            </xpath>
        </field>
    </record>

    <!-- Extensão da list view com coluna de contagem de documentos -->
    <record id="view_governance_case_list_documents_ext" model="ir.ui.view">
        <field name="name">governance.case.list.documents.ext</field>
        <field name="model">governance.case</field>
        <field name="inherit_id" ref="governance.view_governance_case_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="document_count" optional="hide" string="Docs"/>
            </xpath>
        </field>
    </record>

    <!-- Extensão da kanban view com badges de documentos -->
    <record id="view_governance_case_kanban_documents_ext" model="ir.ui.view">
        <field name="name">governance.case.kanban.documents.ext</field>
        <field name="model">governance.case</field>
        <field name="inherit_id" ref="governance.view_governance_case_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='response_ids']" position="after">
                <field name="document_count"/>
            </xpath>
            <xpath expr="//div[@class='mt-1 text-muted']" position="after">
                <div class="mt-2">
                    <t t-if="record.document_count.raw_value">
                        <span class="badge text-bg-info">
                            <i class="fa fa-file-text-o"/> <t t-esc="record.document_count.raw_value"/>
                        </span>
                    </t>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
