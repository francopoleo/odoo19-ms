<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_market_comparable_list" model="ir.ui.view">
        <field name="name">property.market.comparable.list</field>
        <field name="model">property.market.comparable</field>
        <field name="arch" type="xml">
            <list string="Imóveis Comparáveis" decoration-success="is_internal_closed_deal" decoration-muted="active == False">
                <field name="name"/>
                <field name="valuation_type"/>
                <field name="city"/>
                <field name="neighborhood"/>
                <field name="area_m2"/>
                <field name="total_price"/>
                <field name="price_m2"/>
                <field name="currency_id" invisible="1"/>
                <field name="standard"/>
                <field name="date_observed"/>
                <field name="source_id"/>
                <field name="is_internal_closed_deal"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_property_market_comparable_form" model="ir.ui.view">
        <field name="name">property.market.comparable.form</field>
        <field name="model">property.market.comparable</field>
        <field name="arch" type="xml">
            <form string="Imóvel Comparável">
                <sheet>
                    <group>
                        <group string="Identificação">
                            <field name="name"/>
                            <field name="asset_id"/>
                            <field name="source_id"/>
                            <field name="external_reference"/>
                            <field name="url"/>
                            <field name="date_observed"/>
                        </group>
                        <group string="Classificação">
                            <field name="valuation_type"/>
                            <field name="asset_use_type"/>
                            <field name="standard"/>
                            <field name="conservation"/>
                            <field name="is_internal_closed_deal"/>
                            <field name="weight"/>
                        </group>
                    </group>
                    <group>
                        <group string="Localização">
                            <field name="city"/>
                            <field name="neighborhood"/>
                            <field name="address"/>
                        </group>
                        <group string="Valores">
                            <field name="currency_id"/>
                            <field name="area_m2"/>
                            <field name="total_price"/>
                            <field name="price_m2" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Observações">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_property_market_comparable_search" model="ir.ui.view">
        <field name="name">property.market.comparable.search</field>
        <field name="model">property.market.comparable</field>
        <field name="arch" type="xml">
            <search string="Buscar Comparáveis">
                <field name="name"/>
                <field name="city"/>
                <field name="neighborhood"/>
                <field name="valuation_type"/>
                <field name="standard"/>
                <field name="source_id"/>
            </search>
        </field>
    </record>

    <record id="action_property_market_comparable" model="ir.actions.act_window">
        <field name="name">Comparáveis</field>
        <field name="res_model">property.market.comparable</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_property_market_comparable_search"/>
    </record>
</odoo>
