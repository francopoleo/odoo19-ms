<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_valuation_run_list" model="ir.ui.view">
        <field name="name">property.valuation.run.list</field>
        <field name="model">property.valuation.run</field>
        <field name="arch" type="xml">
            <list string="Estimativas" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'" decoration-info="state == 'calculated'">
                <field name="name"/>
                <field name="valuation_date"/>
                <field name="asset_id"/>
                <field name="valuation_type"/>
                <field name="state"/>
                <field name="area_m2"/>
                <field name="adjusted_price_m2"/>
                <field name="calculated_value"/>
                <field name="low_value"/>
                <field name="high_value"/>
                <field name="approved_value"/>
                <field name="confidence_score"/>
                <field name="currency_id" invisible="1"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_property_valuation_run_form" model="ir.ui.view">
        <field name="name">property.valuation.run.form</field>
        <field name="model">property.valuation.run</field>
        <field name="arch" type="xml">
            <form string="Estimativa de Valor">
                <header>
                    <button name="action_calculate" string="Recalcular" type="object" class="btn-primary" groups="property_valuation_engine.group_property_valuation_manager" invisible="state == 'approved'"/>
                    <button name="action_mark_reviewed" string="Marcar como revisado" type="object" groups="property_valuation_engine.group_property_valuation_manager" invisible="state not in ('calculated','draft')"/>
                    <button name="action_approve" string="Aprovar" type="object" class="btn-success" groups="property_valuation_engine.group_property_valuation_manager" invisible="state == 'approved'"/>
                    <button name="action_reject" string="Rejeitar" type="object" class="btn-secondary" groups="property_valuation_engine.group_property_valuation_manager" invisible="state == 'rejected'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,calculated,reviewed,approved,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Imóvel">
                            <field name="asset_id"/>
                            <field name="valuation_type"/>
                            <field name="valuation_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id"/>
                        </group>
                        <group string="Método">
                            <field name="algorithm_id"/>
                            <field name="algorithm_code"/>
                            <field name="algorithm_version"/>
                            <field name="confidence_score" readonly="1"/>
                            <field name="margin_percent" readonly="1"/>
                        </group>
                    </group>

                    <group string="Dados considerados">
                        <group>
                            <field name="area_m2"/>
                            <field name="city"/>
                            <field name="neighborhood"/>
                        </group>
                        <group>
                            <field name="asset_use_type"/>
                            <field name="standard"/>
                            <field name="conservation"/>
                        </group>
                    </group>

                    <group string="Resultado">
                        <group>
                            <field name="base_price_m2" readonly="1"/>
                            <field name="comparable_price_m2" readonly="1"/>
                            <field name="adjusted_price_m2" readonly="1"/>
                        </group>
                        <group>
                            <field name="calculated_value" readonly="1"/>
                            <field name="low_value" readonly="1"/>
                            <field name="high_value" readonly="1"/>
                            <field name="approved_value"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Fatores">
                            <group>
                                <field name="location_factor"/>
                                <field name="standard_factor" readonly="1"/>
                                <field name="conservation_factor" readonly="1"/>
                                <field name="liquidity_factor"/>
                                <field name="vacancy_factor"/>
                            </group>
                        </page>
                        <page string="Referência m²">
                            <field name="reference_id" readonly="1"/>
                        </page>
                        <page string="Comparáveis">
                            <field name="comparable_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="city"/>
                                    <field name="neighborhood"/>
                                    <field name="area_m2"/>
                                    <field name="total_price"/>
                                    <field name="price_m2"/>
                                    <field name="is_internal_closed_deal"/>
                                    <field name="date_observed"/>
                                </list>
                            </field>
                        </page>
                        <page string="Fontes">
                            <field name="source_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="source_type"/>
                                    <field name="reliability_score"/>
                                    <field name="url"/>
                                </list>
                            </field>
                        </page>
                        <page string="Memória de cálculo">
                            <field name="calculation_notes" readonly="1"/>
                        </page>
                        <page string="Parecer">
                            <group>
                                <field name="approved_by_id" readonly="1"/>
                                <field name="approved_date" readonly="1"/>
                            </group>
                            <field name="review_notes" placeholder="Justificativa do gestor, premissas, restrições, revisão manual..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_property_valuation_run_search" model="ir.ui.view">
        <field name="name">property.valuation.run.search</field>
        <field name="model">property.valuation.run</field>
        <field name="arch" type="xml">
            <search string="Buscar Estimativas">
                <field name="name"/>
                <field name="asset_id"/>
                <field name="valuation_type"/>
                <field name="state"/>
                <field name="city"/>
                <field name="neighborhood"/>
            </search>
        </field>
    </record>

    <record id="view_property_valuation_run_pivot" model="ir.ui.view">
        <field name="name">property.valuation.run.pivot</field>
        <field name="model">property.valuation.run</field>
        <field name="arch" type="xml">
            <pivot string="Análise de Estimativas">
                <field name="valuation_type" type="row"/>
                <field name="city" type="row"/>
                <field name="calculated_value" type="measure"/>
                <field name="adjusted_price_m2" type="measure"/>
                <field name="confidence_score" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_property_valuation_run_graph" model="ir.ui.view">
        <field name="name">property.valuation.run.graph</field>
        <field name="model">property.valuation.run</field>
        <field name="arch" type="xml">
            <graph string="Evolução das Estimativas" type="line">
                <field name="valuation_date" interval="month"/>
                <field name="calculated_value" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_property_valuation_run" model="ir.actions.act_window">
        <field name="name">Estimativas</field>
        <field name="res_model">property.valuation.run</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_property_valuation_run_search"/>
    </record>
</odoo>
