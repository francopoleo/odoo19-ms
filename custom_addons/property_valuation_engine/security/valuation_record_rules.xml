<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_property_valuation_source_company" model="ir.rule">
        <field name="name">Fontes de valuation por empresa</field>
        <field name="model_id" ref="model_property_valuation_source"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('property_valuation_engine.group_property_valuation_user'))]"/>
    </record>

