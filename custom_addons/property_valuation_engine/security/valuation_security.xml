<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==================== PRIVILEGE ==================== -->
    <record id="privilege_valuation" model="res.groups.privilege">
        <field name="name">Valuation</field>
        <field name="sequence" eval="40"/>
        <field name="category_id" ref="common_base.module_category_realestate"/>
    </record>

    <!-- ==================== GROUPS ==================== -->
    <record id="group_property_valuation_user" model="res.groups">
        <field name="name">Usuário de Valuation</field>
        <field name="privilege_id" ref="property_valuation_engine.privilege_valuation"/>
        <field name="comment">Pode consultar estimativas, referências, fontes e comparáveis.</field>
    </record>

    <record id="group_property_valuation_manager" model="res.groups">
        <field name="name">Gestor de Valuation</field>
        <field name="privilege_id" ref="property_valuation_engine.privilege_valuation"/>
        <field name="implied_ids" eval="[(4, ref('property_valuation_engine.group_property_valuation_user'))]"/>
        <field name="comment">Pode configurar fatores, fontes, referências, comparáveis, calcular e aprovar estimativas.</field>
    </record>

    <!--
        Ponte automática de acesso:
        Quem já é Gestor de Imóveis no property_core passa a receber o grupo Gestor de Valuation.
        Isso evita o menu ficar invisível após a instalação do módulo.
    -->
    <record id="property_core.group_property_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('property_valuation_engine.group_property_valuation_manager'))]"/>
    </record>

    <!-- Administradores técnicos também recebem acesso para implantação e suporte. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('property_valuation_engine.group_property_valuation_manager'))]"/>
    </record>
</odoo>
