<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="payment_provider_pix" model="payment.provider">
        <field name="name">PIX</field>
        <field name="code">custom</field>
        <field name="custom_mode">pix</field>
        <field name="redirect_form_view_id" ref="payment_custom.redirect_form"/>
        <!-- pending_msg será gerado por _pix_ensure_pending_msg_is_set abaixo -->
        <field name="pending_msg" eval="False"/>
        <field name="payment_method_ids"
               eval="[Command.set([ref('payment_pix.payment_method_pix')])]"
        />
    </record>

    <!-- Inicializa o pending_msg com as instruções PIX após criar o provedor -->
    <function model="payment.provider"
              name="_pix_ensure_pending_msg_is_set"
              eval="[[ref('payment_pix.payment_provider_pix')]]"/>

</odoo>