<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_demo_generator_form" model="ir.ui.view">
        <field name="name">property.demo.generator.form</field>
        <field name="model">property.demo.generator</field>
        <field name="arch" type="xml">
            <form string="Gerador de Massa de Testes">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        <b>Atenção:</b> este gerador cria dados sintéticos com prefixo <b>DEMO-IMOB</b>. Use apenas em base de teste, homologação ou demonstração.
                    </div>
                    <group>
                        <group string="Volume">
                            <field name="company_id"/>
                            <field name="contract_count"/>
                            <field name="months_past"/>
                            <field name="months_future"/>
                            <field name="clear_previous"/>
                        </group>
                        <group string="Cenários">
                            <field name="create_payment_proofs"/>
                            <field name="create_dossiers"/>
                            <field name="create_governance_cases"/>
                            <field name="create_amendments"/>
                            <field name="create_operations"/>
                            <field name="create_valuation_data"/>
                            <field name="create_commercial_network"/>
                            <field name="create_owner_repasses"/>
                            <field name="create_leads_acquisitions"/>
                            <field name="create_media_gallery"/>
                            <field name="create_contract_history_ocr"/>
                            <field name="create_help_agenda"/>
                        </group>
                    </group>
                    <separator string="Resumo da última execução"/>
                    <field name="summary_html" widget="html" readonly="1"/>
                </sheet>
                <footer>
                    <button name="action_generate" type="object" string="Gerar massa DEMO-IMOB" class="btn-primary"/>
                    <button name="action_clear" type="object" string="Apagar massa DEMO-IMOB" class="btn-secondary"/>
                    <button string="Fechar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_property_demo_generator" model="ir.actions.act_window">
        <field name="name">Gerar Dados de Teste Imobiliário</field>
        <field name="res_model">property.demo.generator</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_property_demo_generator_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_property_demo_generator"
              name="Dados de Teste"
              parent="property_core.menu_property_root"
              action="action_property_demo_generator"
              sequence="99"
              groups="base.group_system"/>
</odoo>
