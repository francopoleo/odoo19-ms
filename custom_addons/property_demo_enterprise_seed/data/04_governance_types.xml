<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- GOVERNANCE EMAIL CHANNELS -->
        <record id="demo_email_channel_general" model="governance.email.channel">
            <field name="name">Governança Geral</field>
            <field name="alias_name">governance-demo</field>
            <field name="case_type_id" ref="governance.case_type_operacional"/>
            <field name="active">True</field>
        </record>

        <record id="demo_email_channel_legal" model="governance.email.channel">
            <field name="name">Jurídico</field>
            <field name="alias_name">juridico-demo</field>
            <field name="case_type_id" ref="governance.case_type_juridico"/>
            <field name="active">True</field>
        </record>

        <!-- GOVERNANCE SLA RULES -->
        <record id="demo_sla_rule_audit" model="governance.sla.rule">
            <field name="case_type_id" ref="governance.case_type_documental"/>
            <field name="response_sla_days">7</field>
            <field name="resolution_sla_days">30</field>
        </record>

        <record id="demo_sla_rule_legal" model="governance.sla.rule">
            <field name="case_type_id" ref="governance.case_type_juridico"/>
            <field name="response_sla_days">5</field>
            <field name="resolution_sla_days">20</field>
        </record>

        <record id="demo_sla_rule_compliance" model="governance.sla.rule">
            <field name="case_type_id" ref="governance.case_type_compliance"/>
            <field name="response_sla_days">3</field>
            <field name="resolution_sla_days">15</field>
        </record>

    </data>
</odoo>
