<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- DOCUMENT CATEGORIES -->
        <record id="demo_doc_category_legal" model="document.category">
            <field name="name">Jurídico</field>
            <field name="code">LEGAL</field>
            <field name="sequence">10</field>
        </record>

        <record id="demo_doc_category_financial" model="document.category">
            <field name="name">Financeiro</field>
            <field name="code">FINANCIAL</field>
            <field name="sequence">20</field>
        </record>

        <record id="demo_doc_category_operational" model="document.category">
            <field name="name">Operacional</field>
            <field name="code">OPERATIONAL</field>
            <field name="sequence">30</field>
        </record>

        <!-- DOCUMENT TYPES -->
        <record id="demo_doc_type_contract" model="document.type">
            <field name="name">Contrato de Locação</field>
            <field name="code">CONTRACT</field>
            <field name="category_id" ref="demo_doc_category_legal"/>
            <field name="scope">property</field>
            <field name="requires_expiry">True</field>
            <field name="requires_validation">True</field>
            <field name="is_sensitive">False</field>
            <field name="sequence">10</field>
        </record>

        <record id="demo_doc_type_rg" model="document.type">
            <field name="name">RG/Identidade</field>
            <field name="code">RG</field>
            <field name="category_id" ref="demo_doc_category_legal"/>
            <field name="scope">property</field>
            <field name="requires_expiry">True</field>
            <field name="is_sensitive">True</field>
            <field name="sequence">20</field>
        </record>

        <record id="demo_doc_type_bank_statement" model="document.type">
            <field name="name">Extrato Bancário</field>
            <field name="code">BANK_STMT</field>
            <field name="category_id" ref="demo_doc_category_financial"/>
            <field name="scope">property</field>
            <field name="is_sensitive">True</field>
            <field name="sequence">30</field>
        </record>

        <record id="demo_doc_type_property_reg" model="document.type">
            <field name="name">Registro de Imóvel</field>
            <field name="code">PROP_REG</field>
            <field name="category_id" ref="demo_doc_category_legal"/>
            <field name="scope">asset</field>
            <field name="requires_validation">True</field>
            <field name="sequence">40</field>
        </record>

        <record id="demo_doc_type_insurance" model="document.type">
            <field name="name">Apólice de Seguro</field>
            <field name="code">INSURANCE</field>
            <field name="category_id" ref="demo_doc_category_financial"/>
            <field name="scope">asset</field>
            <field name="requires_expiry">True</field>
            <field name="sequence">50</field>
        </record>

        <record id="demo_doc_type_inspection" model="document.type">
            <field name="name">Relatório de Vistoria</field>
            <field name="code">INSPECTION</field>
            <field name="category_id" ref="demo_doc_category_operational"/>
            <field name="scope">asset</field>
            <field name="sequence">60</field>
        </record>

    </data>
</odoo>
