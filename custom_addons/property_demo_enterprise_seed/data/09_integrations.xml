<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- INTEGRAÇÃO: Documentos vinculados aos Imóveis (Many2many) -->
        <record id="demo_asset_sp_paulista" model="property.asset">
            <field name="document_ids" eval="[(6, 0, [ref('demo_document_contract_sp_2024'), ref('demo_document_property_reg_sp'), ref('demo_document_insurance_sp'), ref('demo_document_inspection_sp')])]"/>
        </record>

        <record id="demo_asset_rj_flamengo" model="property.asset">
            <field name="document_ids" eval="[(6, 0, [ref('demo_document_contract_rj_2024')])]"/>
        </record>

        <!-- INTEGRAÇÃO: Documentos vinculados aos Contratos (One2many via contract_id) -->
        <record id="demo_document_contract_sp_2024" model="document.document">
            <field name="contract_id" ref="demo_contract_sp_paulista"/>
        </record>

        <record id="demo_document_rg_tenant_1" model="document.document">
            <field name="contract_id" ref="demo_contract_sp_paulista"/>
        </record>

        <record id="demo_document_bank_statement_sp" model="document.document">
            <field name="contract_id" ref="demo_contract_sp_paulista"/>
        </record>

        <record id="demo_document_contract_rj_2024" model="document.document">
            <field name="contract_id" ref="demo_contract_rj_flamengo"/>
        </record>
    </data>
</odoo>
