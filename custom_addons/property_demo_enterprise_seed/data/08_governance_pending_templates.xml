<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- A pendência é uma ação verificável; documentos continuam no dossiê. -->
        <record id="demo_pending_template_triage_classify" model="governance.case.type.pending.template">
            <field name="case_type_id" ref="governance.case_type_triagem_geral"/><field name="sequence">10</field>
            <field name="name">Identificar imóvel, contrato e partes envolvidas</field>
            <field name="description">Registrar o contexto inicial e confirmar os vínculos antes de encaminhar o caso ao fluxo adequado.</field>
            <field name="default_deadline_days">1</field><field name="priority">2</field><field name="required">True</field>
        </record>
        <record id="demo_pending_template_triage_documents" model="governance.case.type.pending.template">
            <field name="case_type_id" ref="governance.case_type_triagem_geral"/><field name="sequence">20</field>
            <field name="name">Conferir documentos iniciais e registrar faltas</field>
            <field name="description">Verificar o dossiê disponível e listar os documentos necessários para a análise.</field>
            <field name="default_deadline_days">3</field><field name="priority">1</field><field name="required">True</field>
        </record>
        <record id="demo_pending_template_triage_route" model="governance.case.type.pending.template">
            <field name="case_type_id" ref="governance.case_type_triagem_geral"/><field name="sequence">30</field>
            <field name="name">Definir responsável, prazo e próximo encaminhamento</field>
            <field name="description">Registrar o tipo de caso, responsável e decisão de encaminhamento para o fluxo jurídico, financeiro ou operacional.</field>
            <field name="default_deadline_days">3</field><field name="priority">2</field><field name="required">True</field>
        </record>

        <record id="demo_pending_template_legal_documents" model="governance.case.type.pending.template">
            <field name="case_type_id" ref="governance.case_type_juridico"/><field name="sequence">10</field>
            <field name="name">Reunir contrato, aditivos e comunicações relacionadas</field>
            <field name="description">Localizar instrumentos assinados, aditivos vigentes e comunicações. Vincular arquivos ao dossiê.</field>
            <field name="default_deadline_days">2</field><field name="priority">2</field><field name="required">True</field>
        </record>
        <record id="demo_pending_template_legal_evidence" model="governance.case.type.pending.template">
            <field name="case_type_id" ref="governance.case_type_juridico"/><field name="sequence">20</field>
            <field name="name">Conferir documentos e evidências do imóvel</field>
            <field name="description">Verificar se matrícula, vistoria, notificações e comprovantes sustentam os fatos do caso.</field>
            <field name="default_deadline_days">5</field><field name="priority">2</field><field name="required">True</field>
        </record>
        <record id="demo_pending_template_legal_opinion" model="governance.case.type.pending.template">
            <field name="case_type_id" ref="governance.case_type_juridico"/><field name="sequence">30</field>
            <field name="name">Emitir parecer sobre a providência recomendada</field>
            <field name="description">Registrar análise, riscos, recomendação e condições para executar a decisão.</field>
            <field name="default_deadline_days">10</field><field name="priority">3</field><field name="required">True</field>
        </record>

        <record id="demo_pending_template_finance_open_items" model="governance.case.type.pending.template">
            <field name="case_type_id" ref="governance.case_type_financeiro"/><field name="sequence">10</field>
            <field name="name">Conferir valores em aberto do contrato</field>
            <field name="description">Comparar aluguel, encargos, multas, pagamentos e saldo atualizado antes de cobrar ou repassar.</field>
            <field name="default_deadline_days">2</field><field name="priority">2</field><field name="required">True</field>
        </record>
        <record id="demo_pending_template_finance_proofs" model="governance.case.type.pending.template">
            <field name="case_type_id" ref="governance.case_type_financeiro"/><field name="sequence">20</field>
            <field name="name">Validar pagamentos e comprovantes</field>
            <field name="description">Confirmar pagamentos e anexar os comprovantes conciliados ao dossiê financeiro.</field>
            <field name="default_deadline_days">5</field><field name="priority">2</field><field name="required">True</field>
        </record>
        <record id="demo_pending_template_finance_repass" model="governance.case.type.pending.template">
            <field name="case_type_id" ref="governance.case_type_financeiro"/><field name="sequence">30</field>
            <field name="name">Aprovar cálculo do repasse ao proprietário</field>
            <field name="description">Conferir receitas, despesas, comissão da administradora e valor líquido do repasse.</field>
            <field name="default_deadline_days">7</field><field name="priority">3</field><field name="required">True</field>
        </record>

        <record id="demo_pending_template_document_registry" model="governance.case.type.pending.template">
            <field name="case_type_id" ref="governance.case_type_documental"/><field name="sequence">10</field>
            <field name="name">Conferir matrícula, certidões e titularidade</field>
            <field name="description">Validar identificação do imóvel, proprietário e vigência dos documentos registrais.</field>
            <field name="default_deadline_days">5</field><field name="priority">2</field><field name="required">True</field>
        </record>
        <record id="demo_pending_template_document_dossier" model="governance.case.type.pending.template">
            <field name="case_type_id" ref="governance.case_type_documental"/><field name="sequence">20</field>
            <field name="name">Validar o dossiê e relacionar documentos faltantes</field>
            <field name="description">Revisar documentos esperados pelo processo e registrar claramente o que falta.</field>
            <field name="default_deadline_days">8</field><field name="priority">2</field><field name="required">True</field>
        </record>
        <record id="demo_pending_template_document_final" model="governance.case.type.pending.template">
            <field name="case_type_id" ref="governance.case_type_documental"/><field name="sequence">30</field>
            <field name="name">Confirmar versão final dos documentos</field>
            <field name="description">Conferir assinatura, validade, legibilidade e vínculo antes de concluir o caso.</field>
            <field name="default_deadline_days">12</field><field name="priority">1</field><field name="required">True</field>
        </record>

        <record id="demo_pending_template_compliance_requirement" model="governance.case.type.pending.template">
            <field name="case_type_id" ref="governance.case_type_compliance"/><field name="sequence">10</field>
            <field name="name">Identificar requisito aplicável ao imóvel</field>
            <field name="description">Registrar a regra, contrato, política ou exigência que motivou o caso.</field>
            <field name="default_deadline_days">3</field><field name="priority">2</field><field name="required">True</field>
        </record>
        <record id="demo_pending_template_compliance_evidence" model="governance.case.type.pending.template">
            <field name="case_type_id" ref="governance.case_type_compliance"/><field name="sequence">20</field>
            <field name="name">Avaliar risco e evidências disponíveis</field>
            <field name="description">Classificar o risco, registrar os fatos e conferir as evidências no dossiê.</field>
            <field name="default_deadline_days">7</field><field name="priority">2</field><field name="required">True</field>
        </record>
        <record id="demo_pending_template_compliance_action" model="governance.case.type.pending.template">
            <field name="case_type_id" ref="governance.case_type_compliance"/><field name="sequence">30</field>
            <field name="name">Registrar plano corretivo e responsável</field>
            <field name="description">Definir ação corretiva, responsável, prazo e critério objetivo de conclusão.</field>
            <field name="default_deadline_days">12</field><field name="priority">3</field><field name="required">True</field>
        </record>

        <record id="demo_pending_template_operational_inspection" model="governance.case.type.pending.template">
            <field name="case_type_id" ref="governance.case_type_operacional"/><field name="sequence">10</field>
            <field name="name">Agendar e registrar vistoria do imóvel</field>
            <field name="description">Registrar data, participantes, condições encontradas e evidências da vistoria.</field>
            <field name="default_deadline_days">3</field><field name="priority">2</field><field name="required">True</field>
        </record>
        <record id="demo_pending_template_operational_quote" model="governance.case.type.pending.template">
            <field name="case_type_id" ref="governance.case_type_operacional"/><field name="sequence">20</field>
            <field name="name">Solicitar e comparar orçamento de manutenção</field>
            <field name="description">Obter orçamento detalhado, identificar responsável pelo custo e registrar aprovação.</field>
            <field name="default_deadline_days">7</field><field name="priority">2</field><field name="required">True</field>
        </record>
        <record id="demo_pending_template_operational_acceptance" model="governance.case.type.pending.template">
            <field name="case_type_id" ref="governance.case_type_operacional"/><field name="sequence">30</field>
            <field name="name">Confirmar execução e aceite do serviço</field>
            <field name="description">Conferir execução, nota, resultado da vistoria e aceite do proprietário ou locatário.</field>
            <field name="default_deadline_days">15</field><field name="priority">1</field><field name="required">True</field>
        </record>

        <record id="demo_pending_template_complaint_fact" model="governance.case.type.pending.template">
            <field name="case_type_id" ref="governance.case_type_reclamacao"/><field name="sequence">10</field>
            <field name="name">Registrar fato, envolvidos e impacto</field>
            <field name="description">Descrever o ocorrido e identificar imóvel, contrato, partes e impacto informado.</field>
            <field name="default_deadline_days">1</field><field name="priority">2</field><field name="required">True</field>
        </record>
        <record id="demo_pending_template_complaint_response" model="governance.case.type.pending.template">
            <field name="case_type_id" ref="governance.case_type_reclamacao"/><field name="sequence">20</field>
            <field name="name">Solicitar resposta formal aos envolvidos</field>
            <field name="description">Enviar comunicação com prazo, pergunta objetiva e documentos necessários para responder.</field>
            <field name="default_deadline_days">5</field><field name="priority">3</field><field name="required">True</field>
        </record>
        <record id="demo_pending_template_complaint_solution" model="governance.case.type.pending.template">
            <field name="case_type_id" ref="governance.case_type_reclamacao"/><field name="sequence">30</field>
            <field name="name">Registrar solução e comunicar o encerramento</field>
            <field name="description">Documentar solução, acordos e comunicação final às partes.</field>
            <field name="default_deadline_days">10</field><field name="priority">2</field><field name="required">True</field>
        </record>
    </data>
</odoo>
