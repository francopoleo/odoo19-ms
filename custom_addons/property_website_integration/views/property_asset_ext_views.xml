<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==================== FORM EXTENSION ==================== -->
    <record id="view_property_asset_form_website_ext" model="ir.ui.view">
        <field name="name">property.asset.form.website.ext</field>
        <field name="model">property.asset</field>
        <field name="inherit_id" ref="property_core.view_property_asset_form"/>
        <field name="arch" type="xml">
            <div class="oe_title" position="before">
                <field name="image_1920" widget="image" class="oe_avatar"
                       options="{'preview_image': 'image_512'}"/>
            </div>
            <xpath expr="//field[@name='tag_ids']/.." position="after">
                <group string="Publicação e Acesso">
                    <group>
                        <field name="website_published"/>
                        <field name="website_visibility" readonly="not website_published"/>
                        <field name="website_lead_policy" readonly="not website_published"/>
                        <field name="website_access_summary" readonly="1"/>
                    </group>
                    <group>
                        <field name="hide_when_unavailable"/>
                        <field name="show_unavailable_on_website"/>
                        <field name="publish_start_date"/>
                        <field name="publish_end_date"/>
                    </group>
                </group>

                <group string="Corretores Autorizados" invisible="website_visibility != 'restricted_brokers' and not is_exclusive">
                    <group>
                        <field name="is_exclusive"/>
                        <field name="exclusive_broker_id" invisible="not is_exclusive"/>
                    </group>
                    <group>
                        <field name="authorized_broker_ids" widget="many2many_tags"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- ==================== GALLERY TAB ==================== -->
    <record id="view_property_asset_form_gallery_ext" model="ir.ui.view">
        <field name="name">property.asset.form.gallery.ext</field>
        <field name="model">property.asset</field>
        <field name="inherit_id" ref="property_core.view_property_asset_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@id='tab_notes_comms']" position="before">
                <page string="Galeria" id="tab_gallery">
                    <div class="alert alert-info" role="alert">
                        <p class="mb-0"><i class="fa fa-camera" title="Galeria"></i> Fotos comerciais/publicáveis do imóvel. Use para site, portal e apresentação comercial.</p>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0">Fotos da Galeria / Site</h5>
                        <button name="action_open_gallery_media_wizard" type="object" class="btn btn-primary btn-sm" icon="fa-camera" string="Adicionar Fotos à Galeria"/>
                    </div>
                    <field name="gallery_media_ids" mode="kanban,list,form" context="{'default_asset_id': id, 'default_purpose': 'asset_gallery', 'default_content_kind': 'image', 'default_visibility_level': 'public'}">
                        <kanban class="o_kanban_small">
                            <field name="id"/>
                            <field name="name"/>
                            <field name="image_512"/>
                            <field name="category_id"/>
                            <field name="is_cover"/>
                            <field name="website_published"/>
                            <templates>
                                <t t-name="card">
                                    <div class="oe_kanban_global_click position-relative h-100">
                                        <t t-if="record.image_512.raw_value">
                                            <img t-attf-src="/web/image/property.media/#{record.id.raw_value}/image_512" alt="Foto" style="width:100%; height:150px; object-fit:cover; display:block;"/>
                                        </t>
                                        <t t-else=""><div style="height:150px;background:#f5f5f5;display:flex;align-items:center;justify-content:center;"><i class="fa fa-image" title="Sem imagem" style="font-size:32px;color:#ccc;"/></div></t>
                                        <div class="oe_kanban_details pt-2 px-2">
                                            <h6 class="mb-1 text-truncate"><t t-out="record.name.value"/></h6>
                                            <div class="small text-muted"><t t-out="record.category_id.value"/></div>
                                            <div class="mt-2">
                                                <t t-if="record.is_cover.raw_value"><span class="badge bg-warning text-dark">★ Capa</span></t>
                                                <t t-if="record.website_published.raw_value"><span class="badge bg-success">Site</span></t>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                        <list>
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="category_id"/>
                            <field name="is_cover"/>
                            <field name="website_published"/>
                            <field name="publication_state"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
