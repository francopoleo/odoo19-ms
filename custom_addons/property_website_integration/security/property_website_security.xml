<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Record Rule: Restricted brokers see only published or authorized assets -->
        <record id="rule_property_asset_restricted_broker_website" model="ir.rule">
            <field name="name">Imóveis: usuário restrito vê publicados ou autorizados</field>
            <field name="model_id" ref="property_core.model_property_asset"/>
            <field name="groups" eval="[(4, ref('property_core.group_property_restricted'))]"/>
            <field name="domain_force">['|', ('website_visibility', '=', 'public'), '|', ('authorized_broker_ids.user_id', '=', user.id), ('exclusive_broker_id.user_id', '=', user.id)]</field>
        </record>

    </data>
</odoo>
