<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════
         LIST VIEW
    ═══════════════════════════════════════════════════════════ -->
    <record id="view_property_payment_proof_list" model="ir.ui.view">
        <field name="name">property.payment.proof.list</field>
        <field name="model">property.payment.proof</field>
        <field name="arch" type="xml">
            <list string="Comprovantes de Pagamento"
                  default_order="rent_id, proof_type desc, name"
                  decoration-success="state == 'reconciled'"
                  decoration-warning="state in ('review','matched')"
                  decoration-danger="state in ('failed','rejected') or (is_late_payment and proof_type == 'normal')"
                  decoration-info="proof_type == 'late_fee' and state not in ('reconciled','rejected')">
                <field name="rent_id" string="Parcela"/>
                <field name="name" string="Comprovante"/>
                <field name="proof_type" widget="badge"
                       decoration-danger="proof_type == 'late_fee'"
                       decoration-info="proof_type == 'manual'"/>
                <field name="state" widget="badge"/>
                <field name="contract_id" optional="show"/>
                <field name="late_fee_source_id" string="↳ Juros de" optional="show"/>
                <field name="payment_date"/>
                <field name="amount"/>
                <field name="payment_method" optional="show"/>
                <field name="payer_name" optional="show"/>
                <field name="confidence_score" string="Score" optional="show"/>
                <field name="is_late_payment" column_invisible="1"/>
                <field name="days_late" string="Atraso (dias)" optional="show"/>
                <field name="transaction_id" optional="hide"/>
                <field name="debit_date" string="Data Débito" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         FORM VIEW
    ═══════════════════════════════════════════════════════════ -->
    <record id="view_property_payment_proof_form" model="ir.ui.view">
        <field name="name">property.payment.proof.form</field>
        <field name="model">property.payment.proof</field>
        <field name="arch" type="xml">
            <form string="Comprovante de Pagamento">
                <header>
                    <!-- OCR — somente para comprovantes com arquivo -->
                    <button name="action_extract" type="object" string="Extrair OCR" class="btn-primary"
                            invisible="state != 'draft' or proof_type == 'manual'"/>
                    <button name="action_extract" type="object" string="Re-extrair OCR"
                            invisible="state not in ('extracted','matched','review','failed') or proof_type == 'manual'"/>
                    <button name="action_match" type="object" string="Buscar Parcelas"
                            invisible="state not in ('extracted','review','matched') or proof_type in ('late_fee','manual')"/>
                    <button name="action_use_match" type="object" string="Usar Melhor Sugestão"
                            invisible="not suggested_match_id or state == 'reconciled' or proof_type in ('late_fee','manual')"/>
                    <!-- Confirmar: label diferente para juros/mora -->
                    <button name="action_approve_and_reconcile" type="object"
                            string="Confirmar Recebimento dos Juros" class="oe_highlight"
                            invisible="not rent_id or state == 'reconciled' or proof_type != 'late_fee'"/>
                    <button name="action_approve_and_reconcile" type="object"
                            string="Aprovar e Registrar Pagamento" class="oe_highlight"
                            invisible="not rent_id or state == 'reconciled' or proof_type not in ('normal','manual')"/>
                    <!-- Tratamento de atraso: somente para comprovantes normais -->
                    <button name="action_request_late_fee" type="object" string="Solicitar Juros/Mora"
                            class="btn-warning"
                            invisible="not is_late_payment or late_handling not in [False,'none'] or state == 'reconciled' or proof_type != 'normal'"/>
                    <button name="action_defer_to_next_month" type="object" string="Diferir p/ Próximo Mês"
                            invisible="not is_late_payment or late_handling not in [False,'none'] or state == 'reconciled' or proof_type != 'normal'"/>
                    <button name="action_waive_late_fee" type="object" string="Dispensar Juros"
                            invisible="not is_late_payment or late_handling not in [False,'none'] or state == 'reconciled' or proof_type != 'normal'"/>
                    <button name="action_print_receipt" type="object" string="Imprimir Recibo" icon="fa-print"
                            invisible="state != 'reconciled' or not rent_id"/>
                    <button name="action_reject" type="object" string="Rejeitar"
                            invisible="state in ('reconciled','rejected')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,extracted,matched,review,reconciled"/>
                </header>

                <sheet>
                    <!-- Alertas de atraso (somente comprovantes normais) -->
                    <div class="alert alert-warning mb-0" role="alert"
                         invisible="not is_late_payment or late_handling not in [False,'none'] or proof_type != 'normal'">
                        <strong>Pagamento em Atraso:</strong>
                        <field name="days_late" readonly="1"/> dia(s) após o vencimento.
                        Defina o tratamento pelos botões no topo.
                    </div>
                    <div class="alert alert-info mb-0" role="alert"
                         invisible="not is_late_payment or late_handling in [False,'none'] or proof_type != 'normal'">
                        <strong>Atraso — Tratamento registrado:</strong>
                        <field name="late_handling" readonly="1"/>
                    </div>

                    <!-- Campos auxiliares para invisible= -->
                    <field name="is_late_payment" invisible="1"/>
                    <field name="days_late" invisible="1"/>
                    <field name="currency_id" invisible="1"/>

                    <!-- Título com badge de tipo -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                            <field name="proof_type" widget="badge" nolabel="1"
                                   style="margin-left:8px;vertical-align:middle;"
                                   decoration-danger="proof_type == 'late_fee'"
                                   decoration-info="proof_type == 'manual'"/>
                        </h1>
                    </div>

                    <!-- ════════════════════════════════════════
                         CARD: JUROS/MORA  (somente late_fee)
                    ════════════════════════════════════════ -->
                    <div invisible="proof_type != 'late_fee'"
                         style="background:#fff8e1;border:1px solid #ffc107;border-radius:8px;padding:16px 20px;margin-bottom:16px;">
                        <div style="font-size:13px;font-weight:700;color:#856404;margin-bottom:12px;">
                            Comprovante de Juros e Mora — aguardando envio do locatário
                        </div>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div style="font-size:10px;color:#6c757d;text-transform:uppercase;letter-spacing:0.8px;margin-bottom:3px;">Comprovante Original</div>
                                <field name="late_fee_source_id" readonly="1" nolabel="1"/>
                            </div>
                            <div class="col-md-4">
                                <div style="font-size:10px;color:#6c757d;text-transform:uppercase;letter-spacing:0.8px;margin-bottom:3px;">Contrato</div>
                                <field name="contract_id" readonly="1" nolabel="1"/>
                            </div>
                            <div class="col-md-4">
                                <div style="font-size:10px;color:#6c757d;text-transform:uppercase;letter-spacing:0.8px;margin-bottom:3px;">Parcela Vinculada</div>
                                <field name="rent_id" readonly="1" nolabel="1"/>
                            </div>
                            <div class="col-md-4">
                                <div style="font-size:10px;color:#6c757d;text-transform:uppercase;letter-spacing:0.8px;margin-bottom:3px;">Multa Calculada</div>
                                <field name="calculated_fine" readonly="1" nolabel="1"/>
                            </div>
                            <div class="col-md-4">
                                <div style="font-size:10px;color:#6c757d;text-transform:uppercase;letter-spacing:0.8px;margin-bottom:3px;">Juros Calculados</div>
                                <field name="calculated_interest" readonly="1" nolabel="1"/>
                            </div>
                            <div class="col-md-4">
                                <div style="font-size:10px;font-weight:700;color:#856404;text-transform:uppercase;letter-spacing:0.8px;margin-bottom:3px;">Total a Cobrar</div>
                                <field name="amount" readonly="1" nolabel="1"/>
                            </div>
                        </div>
                    </div>

                    <!-- ════════════════════════════════════════
                         CARD: PAGAMENTO MANUAL  (somente manual)
                    ════════════════════════════════════════ -->
                    <div invisible="proof_type != 'manual'"
                         style="background:#e8f4fd;border:1px solid #0dcaf0;border-radius:8px;padding:16px 20px;margin-bottom:16px;">
                        <div style="font-size:13px;font-weight:700;color:#0c4a6e;margin-bottom:12px;">
                            Pagamento Manual — sem comprovante físico
                        </div>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div style="font-size:10px;color:#6c757d;text-transform:uppercase;letter-spacing:0.8px;margin-bottom:3px;">Contrato</div>
                                <field name="contract_id" readonly="1" nolabel="1"/>
                            </div>
                            <div class="col-md-4">
                                <div style="font-size:10px;color:#6c757d;text-transform:uppercase;letter-spacing:0.8px;margin-bottom:3px;">Parcela</div>
                                <field name="rent_id" readonly="1" nolabel="1"/>
                            </div>
                            <div class="col-md-4">
                                <div style="font-size:10px;color:#6c757d;text-transform:uppercase;letter-spacing:0.8px;margin-bottom:3px;">Valor Pago</div>
                                <field name="amount" readonly="1" nolabel="1"/>
                            </div>
                            <div class="col-md-4">
                                <div style="font-size:10px;color:#6c757d;text-transform:uppercase;letter-spacing:0.8px;margin-bottom:3px;">Data de Pagamento</div>
                                <field name="payment_date" readonly="1" nolabel="1"/>
                            </div>
                            <div class="col-md-4">
                                <div style="font-size:10px;color:#6c757d;text-transform:uppercase;letter-spacing:0.8px;margin-bottom:3px;">Método</div>
                                <field name="payment_method" readonly="1" nolabel="1"/>
                            </div>
                            <div class="col-md-4">
                                <div style="font-size:10px;color:#6c757d;text-transform:uppercase;letter-spacing:0.8px;margin-bottom:3px;">Recebimento</div>
                                <field name="payment_id" readonly="1" nolabel="1"/>
                            </div>
                            <div class="col-12">
                                <div style="font-size:10px;color:#6c757d;text-transform:uppercase;letter-spacing:0.8px;margin-bottom:3px;">Motivo Registrado</div>
                                <field name="extraction_log" readonly="1" nolabel="1"/>
                            </div>
                        </div>
                    </div>

                    <!-- ════════════════════════════════════════
                         CARD: JUROS FILHOS gerados (somente normal com late_fee)
                    ════════════════════════════════════════ -->
                    <div invisible="proof_type != 'normal' or not late_fee_proof_ids"
                         style="background:#fff8e1;border:2px solid #ffc107;border-radius:8px;padding:14px 18px;margin-bottom:16px;">
                        <div style="font-size:12px;font-weight:700;color:#856404;margin-bottom:10px;text-transform:uppercase;letter-spacing:0.5px;">
                            <i class="fa fa-exclamation-triangle" title="Juros"/> Juros/Mora Gerados para esta Parcela
                        </div>
                        <field name="late_fee_proof_ids" readonly="1" nolabel="1">
                            <list string="Juros/Mora"
                                  decoration-success="state == 'reconciled'"
                                  decoration-warning="state == 'draft'">
                                <field name="name" string="Comprovante de Juros"/>
                                <field name="state" widget="badge"/>
                                <field name="amount" string="Valor Cobrado"/>
                                <field name="calculated_fine" string="Multa" optional="show"/>
                                <field name="calculated_interest" string="Juros" optional="show"/>
                                <field name="payment_date" string="Data Pago" optional="show"/>
                                <field name="payer_name" optional="show"/>
                            </list>
                        </field>
                    </div>

                    <!-- ════════════════════════════════════════
                         LAYOUT NORMAL: arquivo | OCR + conciliação
                    ════════════════════════════════════════ -->
                    <div class="row" invisible="proof_type != 'normal'">

                        <!-- Coluna esquerda: arquivo + PDF viewer -->
                        <div class="col-lg-6">
                            <group string="Arquivo">
                                <field name="proof_filename" invisible="1"/>
                                <field name="proof_file" filename="proof_filename" string="Comprovante"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="extraction_log" readonly="1"/>
                            </group>
                            <div invisible="not proof_file" style="margin-top:8px;">
                                <div style="border:1px solid #dee2e6;border-radius:4px;overflow:hidden;min-height:600px;">
                                    <field name="proof_file" widget="pdf_viewer" nolabel="1" readonly="1" string="Prévia"/>
                                </div>
                            </div>
                        </div>

                        <!-- Coluna direita: dados OCR + conciliação -->
                        <div class="col-lg-6">
                            <group string="Dados Extraídos">
                                <field name="payment_method"/>
                                <field name="payment_date" string="Data da Transação"/>
                                <field name="debit_date" string="Data de Débito"/>
                                <field name="amount"/>
                                <field name="payer_name"/>
                                <field name="payer_vat"/>
                                <field name="pix_key" string="Chave PIX do Pagador"/>
                                <field name="transaction_id"/>
                                <field name="bank_name"/>
                            </group>

                            <group string="Conciliação">
                                <group>
                                    <field name="contract_id"/>
                                    <field name="rent_id"/>
                                    <field name="payment_id" readonly="1"/>
                                </group>
                                <group>
                                    <field name="suggested_match_id" readonly="1"/>
                                    <field name="confidence_score" readonly="1"/>
                                    <field name="receiver_name"/>
                                </group>
                            </group>

                            <group string="Atraso" invisible="not is_late_payment">
                                <field name="days_late" readonly="1" string="Dias de Atraso"/>
                                <field name="late_handling" string="Tratamento"/>
                                <field name="calculated_fine" readonly="1" invisible="not calculated_fine"/>
                                <field name="calculated_interest" readonly="1" invisible="not calculated_interest"/>
                            </group>
                        </div>
                    </div>

                    <!-- ════════════════════════════════════════
                         LAYOUT LATE_FEE: arquivo locatário | dados + conciliação
                    ════════════════════════════════════════ -->
                    <div class="row" invisible="proof_type != 'late_fee'">

                        <!-- Coluna esquerda: upload do comprovante do locatário -->
                        <div class="col-lg-6">
                            <group string="Comprovante do Locatário">
                                <field name="proof_filename" invisible="1"/>
                                <field name="proof_file" filename="proof_filename" string="Arquivo"/>
                                <field name="extraction_log" readonly="1" invisible="not extraction_log"/>
                            </group>
                            <div class="alert alert-secondary" role="alert"
                                 invisible="proof_file"
                                 style="font-size:12px;color:#495057;">
                                Quando o locatário enviar o comprovante de pagamento dos juros,
                                faça o upload acima e clique em <strong>Extrair OCR</strong>.
                            </div>
                            <div invisible="not proof_file" style="margin-top:8px;">
                                <div style="border:1px solid #dee2e6;border-radius:4px;overflow:hidden;min-height:400px;">
                                    <field name="proof_file" widget="pdf_viewer" nolabel="1" readonly="1" string="Prévia"/>
                                </div>
                            </div>
                        </div>

                        <!-- Coluna direita: dados quando OCR roda + conciliação simplificada -->
                        <div class="col-lg-6">
                            <group string="Dados do Comprovante Recebido" invisible="state == 'draft'">
                                <field name="payment_method"/>
                                <field name="payment_date" string="Data da Transação"/>
                                <field name="amount"/>
                                <field name="payer_name"/>
                                <field name="transaction_id"/>
                                <field name="bank_name"/>
                            </group>
                            <group string="Conciliação">
                                <field name="contract_id" readonly="1"/>
                                <field name="rent_id" readonly="1"/>
                                <field name="payment_id" readonly="1"/>
                            </group>
                        </div>
                    </div>

                    <!-- ════════════════════════════════════════
                         NOTEBOOK
                    ════════════════════════════════════════ -->
                    <notebook>
                        <!-- Sugestões: só para normal -->
                        <page string="Sugestões" invisible="proof_type in ('late_fee','manual')">
                            <field name="match_line_ids" readonly="1">
                                <list string="Sugestões"
                                      decoration-success="score &gt;= 80"
                                      decoration-warning="score &gt;= 50 and score &lt; 80">
                                    <field name="score" string="Score"/>
                                    <field name="due_date_display" string="Vencimento"/>
                                    <field name="rent_id" string="Parcela"/>
                                    <field name="amount_due" string="Valor"/>
                                    <field name="partner_id" string="Locatário"/>
                                    <field name="contract_id" optional="hide"/>
                                    <field name="reason" string="Motivos" optional="show"/>
                                    <button name="action_select_match" type="object" string="Selecionar"/>
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <field name="score"/>
                                            <field name="rent_id"/>
                                            <field name="due_date"/>
                                            <field name="amount_due"/>
                                            <field name="partner_id"/>
                                            <field name="contract_id"/>
                                            <field name="reason"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>

                        <!-- Texto OCR: oculto para manual -->
                        <page string="Texto OCR" invisible="proof_type == 'manual'">
                            <field name="raw_text" placeholder="Cole aqui o texto do comprovante se o PDF for imagem/scanner ou se o OCR não estiver instalado."/>
                        </page>

                        <!-- JSON técnico: somente para normal -->
                        <page string="JSON Técnico" invisible="proof_type in ('manual','late_fee')">
                            <field name="matched_payload" readonly="1"/>
                        </page>
                    </notebook>

                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         SEARCH VIEW
    ═══════════════════════════════════════════════════════════ -->
    <record id="view_property_payment_proof_search" model="ir.ui.view">
        <field name="name">property.payment.proof.search</field>
        <field name="model">property.payment.proof</field>
        <field name="arch" type="xml">
            <search string="Comprovantes">
                <field name="name"/>
                <field name="payer_name"/>
                <field name="transaction_id"/>
                <field name="rent_id"/>
                <field name="contract_id"/>
                <filter name="pending" string="Pendentes"
                        domain="[('state','in',['draft','extracted','matched','review','failed']),('proof_type','=','normal')]"/>
                <filter name="late_fee_pending" string="Juros Aguardando"
                        domain="[('proof_type','=','late_fee'),('state','not in',['reconciled','rejected'])]"/>
                <filter name="reconciled" string="Conciliados" domain="[('state','=','reconciled')]"/>
                <filter name="late_payment" string="Com Atraso" domain="[('is_late_payment','=',True)]"/>
                <separator/>
                <filter name="type_normal" string="Pagamentos" domain="[('proof_type','=','normal')]"/>
                <filter name="type_manual" string="Manuais" domain="[('proof_type','=','manual')]"/>
                <filter name="type_late_fee" string="Juros/Mora" domain="[('proof_type','=','late_fee')]"/>
                <group>
                    <filter name="group_type" string="Tipo" context="{'group_by':'proof_type'}"/>
                    <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="group_contract" string="Contrato" context="{'group_by':'contract_id'}"/>
                    <filter name="group_method" string="Método" context="{'group_by':'payment_method'}"/>
                    <filter name="group_date" string="Data" context="{'group_by':'payment_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         ACTION
    ═══════════════════════════════════════════════════════════ -->
    <record id="action_property_payment_proof" model="ir.actions.act_window">
        <field name="name">Comprovantes de Pagamento</field>
        <field name="res_model">property.payment.proof</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

</odoo>