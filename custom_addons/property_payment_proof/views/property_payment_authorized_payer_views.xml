<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_payment_authorized_payer_list" model="ir.ui.view">
        <field name="name">property.payment.authorized.payer.list</field>
        <field name="model">property.payment.authorized.payer</field>
        <field name="arch" type="xml">
            <list string="Pagadores Autorizados">
                <field name="active"/>
                <field name="priority"/>
                <field name="contract_id"/>
                <field name="tenant_id"/>
                <field name="name"/>
                <field name="vat"/>
                <field name="pix_key"/>
                <field name="relation_type"/>
            </list>
        </field>
    </record>

    <record id="view_property_payment_authorized_payer_form" model="ir.ui.view">
        <field name="name">property.payment.authorized.payer.form</field>
        <field name="model">property.payment.authorized.payer</field>
        <field name="arch" type="xml">
            <form string="Pagador Autorizado">
                <sheet>
                    <group>
                        <group>
                            <field name="active"/>
                            <field name="contract_id"/>
                            <field name="partner_id"/>
                            <field name="name"/>
                            <field name="vat"/>
                            <field name="pix_key"/>
                        </group>
                        <group>
                            <field name="relation_type"/>
                            <field name="priority"/>
                            <field name="bank_name"/>
                            <field name="bank_account_hint"/>
                            <field name="company_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_property_payment_authorized_payer" model="ir.actions.act_window">
        <field name="name">Pagadores Autorizados</field>
        <field name="res_model">property.payment.authorized.payer</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
