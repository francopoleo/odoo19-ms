<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_s3_storage" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.s3.storage</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="priority" eval="50"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='integration']" position="inside">
                <setting id="s3_storage_setting" string="S3/DigitalOcean Spaces Document Storage"
                         help="Store documents in S3-compatible cloud storage (DigitalOcean Spaces, AWS S3, etc.)">
                    <field name="s3_enabled"/>
                    <div class="content-group mt16" invisible="not s3_enabled">
                        <div>
                            <label for="s3_endpoint" string="Endpoint" class="col-3 col-lg-2 o_light_label"/>
                            <field name="s3_endpoint" placeholder="https://nyc3.digitaloceanspaces.com" class="oe_inline"/>
                        </div>
                        <div class="mt8">
                            <label for="s3_access_key" string="Access Key" class="col-3 col-lg-2 o_light_label"/>
                            <field name="s3_access_key" password="True" placeholder="DO00XXXXXXXXXXXX" class="oe_inline"/>
                        </div>
                        <div class="mt8">
                            <label for="s3_secret_key" string="Secret Key" class="col-3 col-lg-2 o_light_label"/>
                            <field name="s3_secret_key" password="True" placeholder="XXXXXXXXXXXXXXXX" class="oe_inline"/>
                        </div>
                        <div class="mt8">
                            <label for="s3_bucket" string="Bucket Name" class="col-3 col-lg-2 o_light_label"/>
                            <field name="s3_bucket" placeholder="seu-bucket-odoo" class="oe_inline"/>
                        </div>
                        <div class="mt8">
                            <label for="s3_region" string="Region" class="col-3 col-lg-2 o_light_label"/>
                            <field name="s3_region" placeholder="nyc3" class="oe_inline"/>
                        </div>
                        <div class="mt16">
                            <button name="action_test_s3_connection" type="object" string="Test Connection" class="btn btn-primary"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>