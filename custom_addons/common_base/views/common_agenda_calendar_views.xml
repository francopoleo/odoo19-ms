<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Agenda Geral - calendário operacional separado do Calendar
         nativo do Odoo, que representa reuniões.
         ============================================================ -->

    <record id="view_common_agenda_calendar_event_calendar" model="ir.ui.view">
        <field name="name">common.agenda.event.calendar</field>
        <field name="model">common.agenda.event</field>
        <field name="arch" type="xml">
            <calendar string="Agenda Geral" date_start="start" date_stop="stop" color="color" mode="month" quick_create="false" event_open_popup="true">
                <field name="name"/>
                <field name="agenda_module"/>
                <field name="agenda_type"/>
                <field name="user_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="view_common_agenda_calendar_event_list" model="ir.ui.view">
        <field name="name">common.agenda.event.list</field>
        <field name="model">common.agenda.event</field>
        <field name="arch" type="xml">
            <list string="Agenda Geral" decoration-muted="state == 'cancelled'" decoration-success="state == 'done'">
                <field name="start"/>
                <field name="stop" optional="hide"/>
                <field name="name"/>
                <field name="agenda_module"/>
                <field name="agenda_type"/>
                <field name="user_id"/>
                <field name="responsible_user_ids" widget="many2many_tags" optional="show"/>
                <field name="visibility" optional="hide"/>
                <field name="state"/>
                <field name="source_name" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_common_agenda_calendar_event_form" model="ir.ui.view">
        <field name="name">common.agenda.event.form</field>
        <field name="model">common.agenda.event</field>
        <field name="arch" type="xml">
            <form string="Agenda Geral">
                <header>
                    <button name="action_set_scheduled" type="object" string="Reabrir" class="btn-secondary" invisible="state == 'scheduled'"/>
                    <button name="action_mark_done" type="object" string="Concluir" class="btn-primary" invisible="state in ('done', 'cancelled')"/>
                    <button name="action_cancel" type="object" string="Cancelar" class="btn-secondary" invisible="state == 'cancelled'"/>
                    <button name="action_archive" type="object" string="Arquivar" class="btn-secondary" invisible="not active" confirm="Arquivar este item da Agenda Geral? Ele não será excluído definitivamente."/>
                    <button name="action_open_source" type="object" string="Abrir Registro de Origem" class="btn-link" icon="fa-external-link" invisible="not source_model or not source_res_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,scheduled,done,cancelled"/>
                    <field name="active" invisible="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Assunto da agenda"/></h1>
                    </div>
                    <group>
                        <group string="Quando">
                            <field name="start"/>
                            <field name="stop"/>
                            <field name="duration_hours" readonly="1"/>
                            <field name="all_day"/>
                            <field name="location"/>
                        </group>
                        <group string="Classificação">
                            <field name="agenda_module"/>
                            <field name="agenda_type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="source_name" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Responsáveis">
                            <field name="user_id"/>
                            <field name="responsible_user_ids" widget="many2many_tags"/>
                            <field name="partner_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Visibilidade">
                            <field name="visibility"/>
                            <field name="visible_user_ids" widget="many2many_tags" invisible="visibility != 'custom'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Descrição">
                            <field name="description" placeholder="Observações, instruções, detalhes do compromisso operacional..."/>
                        </page>
                        <page string="Origem" invisible="not source_model">
                            <group>
                                <field name="source_model" readonly="1"/>
                                <field name="source_res_id" readonly="1"/>
                                <field name="source_name" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_common_agenda_calendar_event_search" model="ir.ui.view">
        <field name="name">common.agenda.event.search</field>
        <field name="model">common.agenda.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="source_name"/>
                <field name="user_id"/>
                <field name="responsible_user_ids"/>
                <filter name="my_agenda" string="Minha Agenda" domain="['|', ('user_id', '=', uid), ('responsible_user_ids', 'in', [uid])]"/>
                <filter name="period_start" string="Período" date="start"/>
                <filter name="pending" string="Pendentes" domain="[('state', 'in', ('draft', 'scheduled'))]"/>
                <filter name="done" string="Concluídos" domain="[('state', '=', 'done')]"/>
                <filter name="archived" string="Arquivados" domain="[('active', '=', False)]"/>
                <filter name="module_property" string="Módulo: Imóveis" domain="[('agenda_module', '=', 'property')]"/>
                <filter name="module_governance" string="Módulo: Governança" domain="[('agenda_module', '=', 'governance')]"/>
                <filter name="module_document" string="Módulo: Documentos" domain="[('agenda_module', '=', 'document')]"/>
                <filter name="module_financial" string="Módulo: Financeiro" domain="[('agenda_module', '=', 'financial')]"/>
                <filter name="type_inspection" string="Tipo: Vistoria" domain="[('agenda_type', '=', 'inspection')]"/>
                <filter name="type_maintenance" string="Tipo: Manutenção" domain="[('agenda_type', '=', 'maintenance')]"/>
                <filter name="type_governance_case" string="Tipo: Caso de Governança" domain="[('agenda_type', '=', 'governance_case')]"/>
                <filter name="type_governance_response_deadline" string="Tipo: Prazo de Resposta" domain="[('agenda_type', '=', 'governance_response_deadline')]"/>
                <filter name="type_governance_resolution_deadline" string="Tipo: Prazo de Resolução" domain="[('agenda_type', '=', 'governance_resolution_deadline')]"/>
                <filter name="type_governance_followup" string="Tipo: Follow-up de Governança" domain="[('agenda_type', '=', 'governance_followup')]"/>
                <filter name="type_governance_pending" string="Tipo: Pendência" domain="[('agenda_type', '=', 'governance_pending')]"/>
                <filter name="type_document" string="Tipo: Documento" domain="[('agenda_type', '=', 'document')]"/>
                <filter name="type_dossier" string="Tipo: Dossiê" domain="[('agenda_type', '=', 'dossier')]"/>
                <filter name="type_rent" string="Tipo: Parcela / Aluguel" domain="[('agenda_type', '=', 'rent')]"/>
                <filter name="group_module" string="Agrupar por Módulo" context="{'group_by': 'agenda_module'}"/>
                <filter name="group_type" string="Agrupar por Tipo" context="{'group_by': 'agenda_type'}"/>
                <filter name="group_user" string="Agrupar por Responsável" context="{'group_by': 'user_id'}"/>
                <filter name="group_state" string="Agrupar por Situação" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!-- Actions keep the previous XML IDs used by other modules. -->
