<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="cron_governance_check_overdue" model="ir.cron">
            <field name="name">Governança: Verificar Casos em Atraso</field>
            <field name="model_id" ref="governance.model_governance_case"/>
            <field name="state">code</field>
            <field name="code">model.action_cron_check_overdue()</field>
            <field name="interval_number">1</field>
<field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    

        <record id="cron_governance_schedule_followups" model="ir.cron">
            <field name="name">Governança: Agendar Follow-ups Automáticos</field>
            <field name="model_id" ref="governance.model_governance_case"/>
            <field name="state">code</field>
            <field name="code">model.action_cron_schedule_followups()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_governance_operational_alerts" model="ir.cron">
            <field name="name">Governança: Alertas Operacionais</field>
            <field name="model_id" ref="governance.model_governance_case"/>
            <field name="state">code</field>
            <field name="code">model.action_cron_schedule_operational_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>