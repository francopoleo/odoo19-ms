<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Follow-up de caso de governança -->
        <record id="activity_type_followup" model="mail.activity.type">
            <field name="name">Follow-up de Governança</field>
            <field name="icon">fa-bell</field>
            <field name="category">default</field>
            <field name="res_model">governance.case</field>
            <field name="delay_count">3</field>
            <field name="delay_unit">days</field>
        </record>

        <!-- Acompanhamento pós-resposta -->
        <record id="activity_type_response_check" model="mail.activity.type">
            <field name="name">Acompanhar Resposta</field>
            <field name="icon">fa-check-circle</field>
            <field name="category">default</field>
            <field name="res_model">governance.case</field>
            <field name="delay_count">1</field>
            <field name="delay_unit">days</field>
        </record>


        <record id="activity_type_response_overdue" model="mail.activity.type">
            <field name="name">Resposta de Governança em Atraso</field>
            <field name="icon">fa-exclamation-triangle</field>
            <field name="category">default</field>
            <field name="res_model">governance.case</field>
            <field name="delay_count">0</field>
            <field name="delay_unit">days</field>
        </record>

        <record id="activity_type_required_pending" model="mail.activity.type">
            <field name="name">Pendência Obrigatória de Governança</field>
            <field name="icon">fa-list-alt</field>
            <field name="category">default</field>
            <field name="res_model">governance.case.pending</field>
            <field name="delay_count">0</field>
            <field name="delay_unit">days</field>
        </record>
    </data>
</odoo>
