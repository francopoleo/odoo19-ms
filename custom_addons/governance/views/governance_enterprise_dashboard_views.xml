<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_governance_dashboard_form_enterprise" model="ir.ui.view">
        <field name="name">governance.dashboard.form.enterprise</field>
        <field name="model">governance.dashboard</field>
        <field name="inherit_id" ref="governance.view_governance_dashboard_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Governança Enterprise" col="5" class="mt-3">
                    <button name="action_view_obligations" type="object" class="btn btn-outline-primary"><field name="obligation_open_total" nolabel="1"/> Obrigações abertas</button>
                    <button name="action_view_obligations_overdue" type="object" class="btn btn-outline-danger"><field name="obligation_overdue_total" nolabel="1"/> Obrigações atrasadas</button>
                    <button name="action_view_pending_decisions" type="object" class="btn btn-outline-warning"><field name="decision_pending_total" nolabel="1"/> Decisões pendentes</button>
                    <button name="action_view_critical_risks" type="object" class="btn btn-outline-danger"><field name="critical_risk_total" nolabel="1"/> Riscos críticos</button>
                    <button name="action_view_deficient_controls" type="object" class="btn btn-outline-secondary"><field name="deficient_control_total" nolabel="1"/> Controles deficientes</button>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
