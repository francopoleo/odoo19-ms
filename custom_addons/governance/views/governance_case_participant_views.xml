<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_governance_case_participant_list" model="ir.ui.view">
        <field name="name">governance.case.participant.list</field>
        <field name="model">governance.case.participant</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="case_id" optional="hide"/>
                <field name="partner_id"/>
                <field name="role" widget="badge"/>
                <field name="is_primary" widget="boolean_toggle"/>
                <field name="email" optional="show"/>
                <field name="phone" optional="hide"/>
                <field name="note" optional="show"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_governance_case_participant_form" model="ir.ui.view">
        <field name="name">governance.case.participant.form</field>
        <field name="model">governance.case.participant</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="case_id"/>
                            <field name="partner_id"/>
                            <field name="role"/>
                            <field name="is_primary"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="email" readonly="1"/>
                            <field name="phone" readonly="1"/>
                            <field name="mobile" readonly="1"/>
                            <field name="note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_governance_case_participant_search" model="ir.ui.view">
        <field name="name">governance.case.participant.search</field>
        <field name="model">governance.case.participant</field>
        <field name="arch" type="xml">
            <search>
                <field name="case_id"/>
                <field name="partner_id"/>
                <field name="role"/>
                <filter string="Principal" name="primary" domain="[('is_primary', '=', True)]"/>
                <filter string="Ativos" name="active" domain="[('active', '=', True)]"/>
                <separator/>
                <filter string="Por Caso" name="group_case" context="{'group_by':'case_id'}"/>
                <filter string="Por Papel" name="group_role" context="{'group_by':'role'}"/>
            </search>
        </field>
    </record>

    <record id="action_governance_case_participant" model="ir.actions.act_window">
        <field name="name">Participantes</field>
        <field name="res_model">governance.case.participant</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
