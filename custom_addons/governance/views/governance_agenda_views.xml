<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="view_governance_case_form_agenda_ext" model="ir.ui.view">
        <field name="name">governance.case.form.agenda.ext</field>
        <field name="model">governance.case</field>
        <field name="inherit_id" ref="governance.view_governance_case_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Agenda e Atividades" name="agenda_activities">
                    <div class="alert alert-info" role="alert">
                        <p class="mb-0"><i class="fa fa-tasks" title="Agenda"/> Atividades são tarefas individuais. A Agenda Geral mostra apenas marcos críticos do caso: prazo de resposta, prazo de resolução, follow-up, pendências formais e compromissos.</p>
                    </div>
                    <group>
                        <group string="Responsáveis">
                            <field name="agenda_responsible_id"/>
                            <field name="agenda_responsible_ids" widget="many2many_tags"/>
                            <field name="agenda_partner_ids" widget="many2many_tags"/>
                        <field name="agenda_visibility"/><field name="agenda_viewer_user_ids" widget="many2many_tags" invisible="agenda_visibility != 'custom'"/></group>
                        <group string="Prazo / Compromisso">
                            <field name="agenda_deadline" placeholder="Se vazio, usa próxima ação, resposta ou resolução"/>
                            <field name="agenda_start"/>
                            <field name="agenda_stop"/>
                            <field name="agenda_duration_hours"/>
                            <field name="agenda_location"/>
                            <field name="agenda_calendar_event_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Notas de Agenda">
                        <field name="agenda_notes" nolabel="1"/>
                    </group>
                    <div class="d-flex gap-2 mt-3">
                        <button name="action_governance_sync_agenda_complete" type="object" string="Sincronizar Atividade + Marcos" class="btn btn-primary" icon="fa-tasks"/>
                        <button name="action_sync_governance_agenda_markers" type="object" string="Sincronizar Marcos da Agenda" class="btn btn-secondary" icon="fa-calendar"/>
                        <button name="action_schedule_case_activity" type="object" string="Só Atividade" class="btn btn-link" icon="fa-tasks"/>
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_governance_case_pending_form_agenda_ext" model="ir.ui.view">
        <field name="name">governance.case.pending.form.agenda.ext</field>
        <field name="model">governance.case.pending</field>
        <field name="inherit_id" ref="governance.view_governance_case_pending_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Agenda e Atividades" name="agenda_activities">
                    <group>
                        <group string="Responsável">
                            <field name="agenda_responsible_id"/>
                            <field name="agenda_responsible_ids" widget="many2many_tags"/>
                        <field name="agenda_visibility"/><field name="agenda_viewer_user_ids" widget="many2many_tags" invisible="agenda_visibility != 'custom'"/></group>
                        <group string="Prazo / Calendário">
                            <field name="agenda_deadline" placeholder="Se vazio, usa o Prazo da pendência"/>
                            <field name="agenda_start"/>
                            <field name="agenda_stop"/>
                            <field name="agenda_duration_hours"/>
                            <field name="agenda_location"/>
                            <field name="agenda_calendar_event_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Notas de Agenda">
                        <field name="agenda_notes" nolabel="1"/>
                    </group>
                    <div class="d-flex gap-2 mt-3">
                        <button name="action_agenda_schedule_activity" type="object" string="Criar/Atualizar Atividade" class="btn btn-primary" icon="fa-tasks"/>
                        <button name="action_agenda_sync_calendar" type="object" string="Sincronizar Agenda Geral" class="btn btn-secondary" icon="fa-calendar"/>
                        <button name="action_agenda_open_calendar_event" type="object" string="Abrir Agenda" class="btn btn-link" icon="fa-external-link" invisible="not agenda_calendar_event_id"/>
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_governance_case_communication_form_agenda_ext" model="ir.ui.view">
        <field name="name">governance.case.communication.form.agenda.ext</field>
        <field name="model">governance.case.communication</field>
        <field name="inherit_id" ref="governance.view_governance_case_communication_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Calendário" name="agenda_calendar" invisible="communication_type != 'meeting'">
                    <group>
                        <group string="Compromisso">
                            <field name="agenda_start"/>
                            <field name="agenda_stop"/>
                            <field name="agenda_duration_hours"/>
                            <field name="agenda_location"/>
                            <field name="agenda_calendar_event_id" readonly="1"/>
                        </group>
                        <group string="Participantes">
                            <field name="agenda_responsible_id"/>
                            <field name="agenda_partner_ids" widget="many2many_tags"/>
                        <field name="agenda_visibility"/><field name="agenda_viewer_user_ids" widget="many2many_tags" invisible="agenda_visibility != 'custom'"/></group>
                    </group>
                    <group string="Notas para o Evento">
                        <field name="agenda_notes" nolabel="1"/>
                    </group>
                    <div class="d-flex gap-2 mt-3">
                        <button name="action_agenda_sync_calendar" type="object" string="Sincronizar Agenda Geral" class="btn btn-primary" icon="fa-calendar"/>
                        <button name="action_agenda_open_calendar_event" type="object" string="Abrir Agenda" class="btn btn-link" icon="fa-external-link" invisible="not agenda_calendar_event_id"/>
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_governance_case_calendar" model="ir.ui.view">
        <field name="name">governance.case.calendar</field>
        <field name="model">governance.case</field>
        <field name="arch" type="xml">
            <calendar string="Agenda de Governança" date_start="agenda_start" date_stop="agenda_stop" color="agenda_responsible_id" event_limit="5">
                <field name="name"/>
                <field name="case_type_id"/>
                <field name="agenda_responsible_id"/>
                <field name="stage_id"/>
            </calendar>
        </field>
    </record>

    <record id="action_governance_case_calendar" model="ir.actions.act_window">
        <field name="name">Agenda de Governança</field>
        <field name="res_model">governance.case</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="domain">[("agenda_start", "!=", False)]</field>
    </record>

</odoo>
