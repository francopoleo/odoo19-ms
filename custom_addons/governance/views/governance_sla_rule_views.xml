<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_governance_sla_rule_list" model="ir.ui.view">
        <field name="name">governance.sla.rule.list</field>
        <field name="model">governance.sla.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="case_type_id" optional="show"/>
                <field name="priority" widget="priority"/>
                <field name="response_sla_days"/>
                <field name="resolution_sla_days"/>
                <field name="followup_days" optional="show"/>
                <field name="auto_create_followup_activity" optional="show"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_governance_sla_rule_form" model="ir.ui.view">
        <field name="name">governance.sla.rule.form</field>
        <field name="model">governance.sla.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Escopo">
                            <field name="active"/>
                            <field name="sequence"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="case_type_id" options="{'no_create_edit': True}"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group string="Prazos">
                            <field name="response_sla_days"/>
                            <field name="resolution_sla_days"/>
                            <field name="followup_days"/>
                            <field name="auto_create_followup_activity"/>
                        </group>
                    </group>
                    <group string="Observações">
                        <field name="notes" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_governance_sla_rule_search" model="ir.ui.view">
        <field name="name">governance.sla.rule.search</field>
        <field name="model">governance.sla.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="case_type_id"/>
                <field name="company_id"/>
                <filter string="Ativas" name="active" domain="[('active','=',True)]"/>
                <separator/>
                <filter string="Por Empresa" name="group_company" context="{'group_by': 'company_id'}"/>
                <filter string="Por Tipo" name="group_type" context="{'group_by': 'case_type_id'}"/>
                <filter string="Por Prioridade" name="group_priority" context="{'group_by': 'priority'}"/>
            </search>
        </field>
    </record>

    <record id="action_governance_sla_rule" model="ir.actions.act_window">
        <field name="name">Regras de SLA</field>
        <field name="res_model">governance.sla.rule</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_governance_sla_rule_search"/>
        <field name="context">{'search_default_active': 1}</field>
    </record>
</odoo>
