<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_document_apply_template_wizard_form" model="ir.ui.view">
        <field name="name">document.apply.template.wizard.form</field>
        <field name="model">document.apply.template.wizard</field>
        <field name="arch" type="xml">
            <form string="Aplicar Template de Dossiê">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        O sistema criará os documentos esperados como rascunhos dentro do dossiê. Depois você alimenta cada item com os arquivos e acompanha se o dossiê está completo.
                    </div>
                    <group>
                        <field name="dossier_id" readonly="1"/>
                        <field name="template_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="create_only_missing"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply_template" type="object" string="Aplicar Template" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
