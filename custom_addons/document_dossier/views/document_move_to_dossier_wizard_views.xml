<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_document_move_to_dossier_wizard_form" model="ir.ui.view">
            <field name="name">document.move.to.dossier.wizard.form</field>
            <field name="model">document.move.to.dossier.wizard</field>
            <field name="arch" type="xml">
                <form string="Mover para Dossiê">
                    <sheet>
                        <div class="alert alert-info" role="alert">
                            Escolha o dossiê de destino. O documento deixará de ser avulso e passará a aparecer em <strong>Documentos do Dossiê</strong>.
                        </div>
                        <group>
                            <field name="document_id" readonly="1"/>
                            <field name="dossier_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_link" type="object" string="Mover" class="btn-primary"/>
                        <button string="Cancelar" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
