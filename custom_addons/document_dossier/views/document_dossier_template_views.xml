<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_document_dossier_template_list" model="ir.ui.view">
        <field name="name">document.dossier.template.list</field>
        <field name="model">document.dossier.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="required_line_count"/>
                <field name="total_line_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_document_dossier_template_form" model="ir.ui.view">
        <field name="name">document.dossier.template.form</field>
        <field name="model">document.dossier.template</field>
        <field name="arch" type="xml">
            <form string="Template de Dossiê">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Ex.: Locação PJ, Locação PF, Compra e Venda"/></h1>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="required_line_count" readonly="1"/>
                            <field name="total_line_count" readonly="1"/>
                        </group>
                    </div>
                    <group string="Descrição">
                        <field name="description" nolabel="1"/>
                    </group>
                    <separator string="Documentos Necessários"/>
                    <field name="line_ids" mode="list,form">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="document_type_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="category_id" readonly="1"/>
                            <field name="required"/>
                            <field name="requires_file"/>
                            <field name="description"/>
                        </list>
                        <form string="Item do Template">
                            <sheet>
                                <group>
                                    <group>
                                        <field name="sequence"/>
                                        <field name="name"/>
                                        <field name="document_type_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                        <field name="category_id" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="required"/>
                                        <field name="requires_file"/>
                                        <field name="description"/>
                                    </group>
                                </group>
                                <group string="Instruções">
                                    <field name="notes" nolabel="1"/>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_document_dossier_template_search" model="ir.ui.view">
        <field name="name">document.dossier.template.search</field>
        <field name="model">document.dossier.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter string="Ativos" name="active_templates" domain="[('active','=',True)]"/>
                <filter string="Inativos" name="inactive_templates" domain="[('active','=',False)]" context="{'active_test': False}"/>
            </search>
        </field>
    </record>

    <record id="action_document_dossier_template" model="ir.actions.act_window">
        <field name="name">Templates de Dossiê</field>
        <field name="res_model">document.dossier.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_document_dossier_template_search"/>
        <field name="context">{'search_default_active_templates': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crie templates para abrir processos documentais padronizados.</p>
            <p>Exemplos: Locação PF, Locação PJ, Fiador PF, Compra e Venda, Regularização de Imóvel.</p>
        </field>
    </record>
</odoo>
