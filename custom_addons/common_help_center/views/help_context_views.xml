<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_help_context_list" model="ir.ui.view">
        <field name="name">help.context.list</field>
        <field name="model">help.context</field>
        <field name="arch" type="xml">
            <list>
                <field name="priority" widget="handle"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="context_kind"/>
                <field name="module_name"/>
                <field name="model_name"/>
                <field name="view_type"/>
                <field name="field_name"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_help_context_form" model="ir.ui.view">
        <field name="name">help.context.form</field>
        <field name="model">help.context</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_articles" type="object" string="Abrir Artigos" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="category_id"/>
                            <field name="context_kind"/>
                            <field name="module_name"/>
                            <field name="model_name"/>
                            <field name="view_type"/>
                            <field name="field_name"/>
                        </group>
                        <group>
                            <field name="menu_xmlid"/>
                            <field name="action_xmlid"/>
                            <field name="priority"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="description"/>
                    <field name="article_ids" widget="many2many_tags"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_help_context" model="ir.actions.act_window">
        <field name="name">Contextos de Ajuda</field>
        <field name="res_model">help.context</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
