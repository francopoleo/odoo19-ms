<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_help_learning_path_list" model="ir.ui.view">
        <field name="name">help.learning.path.list</field>
        <field name="model">help.learning.path</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="module_name"/>
                <field name="audience"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_help_learning_path_form" model="ir.ui.view">
        <field name="name">help.learning.path.form</field>
        <field name="model">help.learning.path</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="module_name"/>
                            <field name="audience"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="description"/>
                    <notebook>
                        <page string="Passos">
                            <field name="step_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="article_id"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_help_learning_path" model="ir.actions.act_window">
        <field name="name">Trilhas de Aprendizado</field>
        <field name="res_model">help.learning.path</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
