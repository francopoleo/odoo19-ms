<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_help_category_list" model="ir.ui.view">
        <field name="name">help.category.list</field>
        <field name="model">help.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="parent_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_help_category_form" model="ir.ui.view">
        <field name="name">help.category.form</field>
        <field name="model">help.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="parent_id"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_help_category" model="ir.actions.act_window">
        <field name="name">Categorias</field>
        <field name="res_model">help.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
