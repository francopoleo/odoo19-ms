<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_help_feedback_list" model="ir.ui.view">
        <field name="name">help.feedback.list</field>
        <field name="model">help.feedback</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="article_id"/>
                <field name="user_id"/>
                <field name="rating"/>
                <field name="model_name"/>
                <field name="record_id"/>
            </list>
        </field>
    </record>
    <record id="view_help_feedback_form" model="ir.ui.view">
        <field name="name">help.feedback.form</field>
        <field name="model">help.feedback</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="article_id"/>
                        <field name="user_id"/>
                        <field name="rating"/>
                        <field name="model_name"/>
                        <field name="record_id"/>
                    </group>
                    <field name="comment"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_help_feedback" model="ir.actions.act_window">
        <field name="name">Avaliações</field>
        <field name="res_model">help.feedback</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
