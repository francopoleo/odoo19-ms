<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═════════════════════════════════════════════════════════════════════════════
         KANBAN VIEW
         ═════════════════════════════════════════════════════════════════════════════ -->

    <record id="view_property_contract_history_kanban" model="ir.ui.view">
        <field name="name">property.contract.history.kanban</field>
        <field name="model">property.contract.history</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="id"/>
                <field name="name"/>
                <field name="state"/>
                <field name="contract_type"/>
                <field name="contract_filename"/>
                <field name="asset_id"/>
                <field name="party1_name"/>
                <field name="monthly_amount"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="parser_used"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card o_has_shadow">
                            <div class="oe_kanban_card_header">
                                <span class="oe_kanban_record_title">
                                    <strong><t t-out="record.name.value"/></strong>
                                </span>
                                <span class="badge float-end" t-attf-class="bg-{{ (record.state.value == 'synced' and 'success') or (record.state.value == 'approved' and 'info') or ((record.state.value == 'extracted' or record.state.value == 'reviewed') and 'warning') or (record.state.value == 'failed' and 'danger') or 'secondary' }}">
                                    <t t-out="record.state.raw_value"/>
                                </span>
                            </div>
                            <div class="oe_kanban_card_content p-2">
                                <div class="mb-2">
                                    <small class="d-block">
                                        <strong>Arquivo:</strong> <t t-out="record.contract_filename.value"/>
                                    </small>
                                    <small class="d-block">
                                        <strong>Tipo:</strong> <t t-out="record.contract_type.raw_value"/>
                                    </small>
                                </div>
                                <div class="mb-2" t-if="record.asset_id.value">
                                    <small class="d-block text-muted">
                                        <strong>Imóvel:</strong> <t t-out="record.asset_id.value"/>
                                    </small>
                                </div>
                                <div class="mb-2" t-if="record.monthly_amount.value">
                                    <small class="d-block">
                                        <strong>Valor/Mês:</strong> <t t-out="record.monthly_amount.value.toLocaleString('pt-BR', {style: 'currency', currency: 'BRL'})"/>
                                    </small>
                                </div>
                                <div t-if="record.start_date.value or record.end_date.value">
                                    <small class="d-block text-muted">
                                        <t t-out="record.start_date.value"/> até <t t-out="record.end_date.value"/>
                                    </small>
                                </div>
                                <div class="mt-2" t-if="record.parser_used.value">
                                    <small class="badge bg-light text-dark">
                                        <t t-out="record.parser_used.value"/>
                                    </small>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ═════════════════════════════════════════════════════════════════════════════
         LIST VIEW
         ═════════════════════════════════════════════════════════════════════════════ -->

    <record id="view_property_contract_history_list" model="ir.ui.view">
        <field name="name">property.contract.history.list</field>
        <field name="model">property.contract.history</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'synced'"
                  decoration-warning="state in ('extracted','reviewed')"
                  decoration-danger="state == 'failed'"
                  decoration-info="state == 'approved'">
                <field name="name"/>
                <field name="contract_filename"/>
                <field name="contract_type" widget="badge"/>
                <field name="state" widget="badge"/>
                <field name="asset_id" optional="show"/>
                <field name="start_date" optional="show"/>
                <field name="end_date" optional="show"/>
                <field name="monthly_amount" optional="show"/>
                <field name="parser_used" optional="hide"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- ═════════════════════════════════════════════════════════════════════════════
         FORM VIEW
         ═════════════════════════════════════════════════════════════════════════════ -->

    <record id="view_property_contract_history_form" model="ir.ui.view">
        <field name="name">property.contract.history.form</field>
        <field name="model">property.contract.history</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_extract" type="object" string="Extrair OCR"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_manual_review" type="object" string="Revisar"
                            class="btn-info" invisible="state != 'extracted'"/>
                    <button name="action_approve" type="object" string="Aprovar"
                            class="btn-success" invisible="state != 'reviewed'"/>
                    <button name="action_find_asset" type="object" string="Buscar Imóvel"
                            class="btn-secondary" invisible="state not in ('extracted','reviewed','approved')"/>
                    <button name="action_confirm_asset_association" type="object" string="Confirmar Associação"
                            class="btn-secondary" invisible="not asset_id or state not in ('extracted','reviewed','approved','synced')"/>
                    <button name="action_create_contract_from_history" type="object" string="Criar Contrato com Dados Extraídos"
                            class="btn-primary" invisible="not asset_id or contract_id or state not in ('extracted','reviewed','approved','synced')"/>
                    <button name="action_sync_to_asset" type="object" string="Sincronizar com Imóvel"
                            class="btn-primary" invisible="state != 'approved'"/>
                    <button name="action_reject" type="object" string="Rejeitar"
                            class="btn-danger"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_lines" type="object" class="oe_stat_button" icon="fa-list">
                            <field string="Campos" name="line_ids" widget="statinfo"/>
                        </button>
                        <button name="action_view_history" type="object" class="oe_stat_button" icon="fa-history"
                                invisible="not history_ids">
                            <field string="Versões" name="history_ids" widget="statinfo"/>
                        </button>
                        <button name="action_view_contract" type="object" class="oe_stat_button" icon="fa-file-text-o"
                                invisible="not contract_id">
                            <field string="Contrato" name="contract_id" widget="statinfo"/>
                        </button>
                    </div>

                    <h2>
                        <field name="name" readonly="1"/>
                    </h2>

                    <!-- TAB 1: FILE & EXTRACTION -->
                    <notebook>
                        <page string="Arquivo &amp; Extração">
                            <group>
                                <group>
                                    <field name="contract_filename" readonly="1"/>
                                    <field name="contract_file" filename="contract_filename" widget="binary" invisible="state != 'draft'"/>
                                    <field name="parser_used" readonly="1"/>
                                    <field name="state" readonly="1"/>
                                </group>
                                <group>
                                    <field name="company_id"/>
                                    <field name="sync_to_asset"/>
                                    <field name="extraction_log" readonly="1" nolabel="1"/>
                                </group>
                            </group>
                            <field name="raw_text" nolabel="1"
                                   placeholder="Cole o texto do contrato aqui se o OCR não funcionar..."/>
                        </page>

                        <!-- TAB 2: METADATA -->
                        <page string="Metadados">
                            <group col="2">
                                <group string="Tipo &amp; Partes">
                                    <field name="contract_type"/>
                                    <field name="party1_name"/>
                                    <field name="party1_vat"/>
                                    <field name="party2_name"/>
                                    <field name="party2_vat"/>
                                </group>
                                <group string="Datas">
                                    <field name="sign_date"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="renewal_date"/>
                                </group>
                            </group>
                            <group col="2" string="Valores">
                                <field name="monthly_amount"/>
                                <field name="total_value"/>
                                <field name="deposit_value"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </page>

                        <!-- TAB 3: PROPERTY DETAILS -->
                        <page string="Endereço do Imóvel">
                            <group col="2">
                                <field name="address" colspan="2"/>
                                <field name="neighborhood"/>
                                <field name="address_complement"/>
                                <field name="city"/>
                                <field name="zip_code"/>
                            </group>
                            <field name="property_description" nolabel="1"/>
                        </page>

                        <!-- TAB 4: EXTRACTED FIELDS -->
                        <page string="Campos Extraídos">
                            <field name="line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="field_name" readonly="1"/>
                                    <field name="parsed_value" readonly="1"/>
                                    <field name="field_type" readonly="1"/>
                                    <field name="confidence" readonly="1" widget="progressbar"/>
                                    <field name="accepted" widget="boolean_toggle"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>

                        <!-- TAB 5: SYNC STATUS -->
                        <page string="Sincronização">
                            <group col="2">
                                <group string="Alvo da Sincronização">
                                    <field name="asset_id" readonly="state == 'synced'" options="{'no_create_edit': False}"/>
                                    <field name="contract_id" readonly="state == 'synced'"/>
                                </group>
                                <group string="Status da Sincronização" invisible="state != 'synced'">
                                    <field name="synced_to_asset_id" readonly="1"/>
                                    <field name="sync_timestamp" readonly="1"/>
                                    <field name="superseded_by_id" readonly="1"/>
                                </group>
                            </group>
                            <field name="sync_log" readonly="1" nolabel="1"
                                   invisible="not sync_log" placeholder="Log da sincronização..."/>
                        </page>

                        <!-- TAB 6: EXTRACTED JSON -->
                        <page string="Dados Extraídos (JSON)" invisible="not matched_payload">
                            <field name="matched_payload" readonly="1" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->

    <record id="view_property_contract_history_search" model="ir.ui.view">
        <field name="name">property.contract.history.search</field>
        <field name="model">property.contract.history</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="contract_filename"/>
                <field name="party1_name"/>
                <field name="party2_name"/>
                <field name="asset_id"/>
                <field name="state"/>
                <filter name="draft" string="Rascunho" domain="[('state', '=', 'draft')]"/>
                <filter name="extracted" string="Extraído" domain="[('state', '=', 'extracted')]"/>
                <filter name="reviewed" string="Revisado" domain="[('state', '=', 'reviewed')]"/>
                <filter name="approved" string="Aprovado" domain="[('state', '=', 'approved')]"/>
                <filter name="synced" string="Sincronizado" domain="[('state', '=', 'synced')]"/>
            </search>
        </field>
    </record>

</odoo>
