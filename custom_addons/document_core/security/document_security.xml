<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <!-- ============================================================
             Privilege (Odoo 19)
        ============================================================ -->
        <record id="privilege_document" model="res.groups.privilege">
            <field name="name">Documentos</field>
            <field name="sequence" eval="10"/>
            <field name="category_id" ref="common_base.module_category_realestate_docs"/>
        </record>

        <!-- ============================================================
             Grupos de Segurança
        ============================================================ -->

        <record id="group_document_operator" model="res.groups">
            <field name="name">Documentos - Operacional</field>
            <field name="privilege_id" ref="document_core.privilege_document"/>
            <field name="comment">Pode cadastrar e manter documentos, anexos e protocolos usando categorias e tipos já definidos. Não pode criar categorias, tipos documentais ou parâmetros mestres.</field>
        </record>

        <record id="group_document_manager" model="res.groups">
            <field name="name">Documentos - Gestor</field>
            <field name="privilege_id" ref="document_core.privilege_document"/>
            <field name="implied_ids" eval="[(4, ref('document_core.group_document_operator'))]"/>
            <field name="comment">Pode administrar documentos, categorias, tipos documentais, localizações físicas, regras de acesso e validações.</field>
        </record>

        <!-- Administradores do sistema herdam a gestão documental. -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('document_core.group_document_manager'))]"/>
        </record>

        <!-- ============================================================
             Regras Multiempresa
        ============================================================ -->

        <record id="rule_document_document_company" model="ir.rule">
            <field name="name">Documentos: Isolamento por Empresa</field>
            <field name="model_id" ref="model_document_document"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('document_core.group_document_operator'))]"/>
        </record>

        <record id="rule_document_location_company" model="ir.rule">
            <field name="name">Localizações Físicas: Isolamento por Empresa</field>
            <field name="model_id" ref="model_document_location"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('document_core.group_document_operator'))]"/>
        </record>

        <!-- ============================================================
             Regras de Workflow
        ============================================================ -->

        <!-- Portal users veem apenas documentos publicados e validados -->
        <record id="rule_document_portal_visibility" model="ir.rule">
            <field name="name">Documentos: Visibilidade no Portal</field>
            <field name="model_id" ref="model_document_document"/>
            <field name="domain_force">[
                ('website_published', '=', True),
                ('document_workflow_state', '=', 'validated'),
                ('website_visibility', 'in', ('portal', 'public'))
            ]</field>
            <field name="perm_read">True</field>
            <field name="perm_write">False</field>
            <field name="perm_create">False</field>
            <field name="perm_unlink">False</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <!-- Users veem seus próprios documentos (draft ou approved) -->
        <record id="rule_document_own_docs" model="ir.rule">
            <field name="name">Documentos: Próprios Documentos</field>
            <field name="model_id" ref="model_document_document"/>
            <field name="domain_force">[
                '|',
                ('created_by_id', '=', user.id),
                ('approved_by_id', '=', user.id)
            ]</field>
            <field name="perm_read">True</field>
            <field name="perm_write">True</field>
            <field name="perm_create">True</field>
            <field name="perm_unlink">False</field>
            <field name="groups" eval="[(4, ref('document_core.group_document_operator'))]"/>
        </record>

        <!-- Managers veem todos os documentos -->
        <record id="rule_document_manager_all" model="ir.rule">
            <field name="name">Documentos: Managers veem todos</field>
            <field name="model_id" ref="model_document_document"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('document_core.group_document_manager'))]"/>
        </record>

</odoo>
