<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_document_category_list" model="ir.ui.view">
        <field name="name">document.category.list</field>
        <field name="model">document.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="default_access_level"/>
                <field name="allow_website_publish"/>
                <field name="type_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_document_category_form" model="ir.ui.view">
        <field name="name">document.category.form</field>
        <field name="model">document.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="default_access_level"/>
                            <field name="allow_website_publish"/>
                            <field name="type_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tipos">
                            <field name="type_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="scope"/>
                                    <field name="default_access_level"/>
                                    <field name="allow_website_publish"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Descrição">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_document_category_search" model="ir.ui.view">
        <field name="name">document.category.search</field>
        <field name="model">document.category</field>
        <field name="arch" type="xml">
            <search string="Pesquisar Categorias Documentais">
                <field name="name"/>
                <field name="code"/>
                <field name="default_access_level"/>
                <filter string="Ativas" name="active" domain="[('active','=',True)]"/>
                <filter string="Inativas" name="inactive" domain="[('active','=',False)]" context="{'active_test': False}"/>
                <filter string="Publicáveis no Site" name="website_allowed" domain="[('allow_website_publish','=',True)]"/>
                <separator/>
                <filter string="Agrupar por Acesso Padrão" name="group_access" context="{'group_by':'default_access_level'}"/>
                <filter string="Agrupar por Publicação no Site" name="group_website_publish" context="{'group_by':'allow_website_publish'}"/>
            </search>
        </field>
    </record>

    <record id="view_document_type_list" model="ir.ui.view">
        <field name="name">document.type.list</field>
        <field name="model">document.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="category_id" string="Categoria"/>
                <field name="name" string="Tipo de Documento"/>
                <field name="active" string="Ativo"/>
            </list>
        </field>
    </record>

    <record id="view_document_type_form" model="ir.ui.view">
        <field name="name">document.type.form</field>
        <field name="model">document.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="category_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="scope"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="default_access_level"/>
                            <field name="allow_website_publish"/>
                            <field name="portal_uploadable"/>
                            <field name="website_default_visibility" invisible="allow_website_publish == False"/>
                            <field name="is_sensitive"/>
                            <field name="document_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Regras">
                            <group>
                                <group>
                                    <field name="requires_issue_date"/>
                                    <field name="requires_expiry"/>
                                    <field name="requires_review"/>
                                    <field name="review_cycle_days"/>
                                </group>
                                <group>
                                    <field name="requires_validation"/>
                                    <field name="requires_physical_original"/>
                                    <field name="allowed_file_types"/>
                                </group>
                            </group>
                        </page>
                        <page string="Descrição">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_document_type_search" model="ir.ui.view">
        <field name="name">document.type.search</field>
        <field name="model">document.type</field>
        <field name="arch" type="xml">
            <search string="Pesquisar Tipos de Documento">
                <field name="name" string="Tipo de Documento"/>
                <field name="category_id" string="Categoria"/>
                <filter string="Ativos" name="active" domain="[('active','=',True)]"/>
                <filter string="Inativos" name="inactive" domain="[('active','=',False)]" context="{'active_test': False}"/>
                <separator/>
                <filter string="Agrupar por Categoria" name="group_category" context="{'group_by':'category_id'}"/>
                <filter string="Agrupar por Ativo" name="group_active" context="{'group_by':'active'}"/>
            </search>
        </field>
    </record>

    <record id="view_document_location_list" model="ir.ui.view">
        <field name="name">document.location.list</field>
        <field name="model">document.location</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="company_id"/>
                <field name="site_name"/>
                <field name="room"/>
                <field name="cabinet"/>
                <field name="box"/>
                <field name="folder"/>
                <field name="responsible_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_document_location_form" model="ir.ui.view">
        <field name="name">document.location.form</field>
        <field name="model">document.location</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="company_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="site_name"/>
                            <field name="room"/>
                            <field name="cabinet"/>
                            <field name="shelf"/>
                            <field name="drawer"/>
                            <field name="box"/>
                            <field name="folder"/>
                            <field name="responsible_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_document_location_search" model="ir.ui.view">
        <field name="name">document.location.search</field>
        <field name="model">document.location</field>
        <field name="arch" type="xml">
            <search string="Pesquisar Localizações Físicas">
                <field name="name"/>
                <field name="code"/>
                <field name="company_id"/>
                <field name="site_name"/>
                <field name="room"/>
                <field name="cabinet"/>
                <field name="box"/>
                <field name="folder"/>
                <field name="responsible_id"/>
                <filter string="Ativas" name="active" domain="[('active','=',True)]"/>
                <filter string="Inativas" name="inactive" domain="[('active','=',False)]" context="{'active_test': False}"/>
                <separator/>
                <filter string="Agrupar por Empresa" name="group_company" context="{'group_by':'company_id'}"/>
                <filter string="Agrupar por Unidade" name="group_site" context="{'group_by':'site_name'}"/>
                <filter string="Agrupar por Responsável" name="group_responsible" context="{'group_by':'responsible_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_document_category" model="ir.actions.act_window">
        <field name="name">Categorias Documentais</field>
        <field name="res_model">document.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_document_type" model="ir.actions.act_window">
        <field name="name">Tipos de Documento</field>
        <field name="res_model">document.type</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_category': 1}</field>
    </record>

    <record id="action_document_location" model="ir.actions.act_window">
        <field name="name">Localizações Físicas</field>
        <field name="res_model">document.location</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
