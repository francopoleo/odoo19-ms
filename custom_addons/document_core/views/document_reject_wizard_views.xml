<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard para Rejeição de Documento -->
    <record id="view_document_reject_wizard_form" model="ir.ui.view">
        <field name="name">document.reject.wizard.form</field>
        <field name="model">document.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Rejeitar Documento">
                <group>
                    <field name="document_id" readonly="1"/>
                    <field name="rejection_notes" placeholder="Explique por que o documento está sendo rejeitado..." colspan="2"/>
                </group>
                <footer>
                    <button name="action_confirm_reject" string="Rejeitar" type="object" class="btn-danger"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>