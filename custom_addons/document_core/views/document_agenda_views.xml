<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="view_document_document_form_agenda_ext" model="ir.ui.view">
        <field name="name">document.document.form.agenda.ext</field>
        <field name="model">document.document</field>
        <field name="inherit_id" ref="document_core.view_document_document_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='responsible_id']/ancestor::group[2]" position="after">
                <separator string="Agenda e Atividades"/>
                <div class="alert alert-info" role="alert">
                    <p class="mb-0"><i class="fa fa-clock-o" title="Agenda"/> Atividades tratam vencimento, revisão e validação. Calendário deve ser usado quando houver reunião ou conferência com horário marcado.</p>
                </div>
                <group>
                    <group string="Responsáveis">
                        <field name="agenda_responsible_id"/>
                        <field name="agenda_responsible_ids" widget="many2many_tags"/>
                        <field name="agenda_partner_ids" widget="many2many_tags"/>
                    <field name="agenda_visibility"/><field name="agenda_viewer_user_ids" widget="many2many_tags" invisible="agenda_visibility != 'custom'"/></group>
                    <group string="Prazo / Compromisso">
                        <field name="agenda_deadline" placeholder="Se vazio, usa revisão ou vencimento"/>
                        <field name="agenda_start"/>
                        <field name="agenda_stop"/>
                        <field name="agenda_duration_hours"/>
                        <field name="agenda_location"/>
                        <field name="agenda_calendar_event_id" readonly="1"/>
                    </group>
                </group>
                <group string="Notas de Agenda">
                    <field name="agenda_notes" nolabel="1"/>
                </group>
                <div class="d-flex gap-2 mt-3">
                    <button name="action_schedule_document_activity" type="object" string="Criar/Atualizar Atividades" class="btn btn-primary" icon="fa-tasks"/>
                    <button name="action_agenda_sync_calendar" type="object" string="Sincronizar Agenda Geral" class="btn btn-secondary" icon="fa-calendar"/>
                    <button name="action_agenda_open_calendar_event" type="object" string="Abrir Agenda" class="btn btn-link" icon="fa-external-link" invisible="not agenda_calendar_event_id"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_document_document_calendar" model="ir.ui.view">
        <field name="name">document.document.calendar</field>
        <field name="model">document.document</field>
        <field name="arch" type="xml">
            <calendar string="Agenda Documental" date_start="agenda_start" date_stop="agenda_stop" color="agenda_responsible_id" event_limit="5">
                <field name="name"/>
                <field name="document_type_id"/>
                <field name="agenda_responsible_id"/>
                <field name="status"/>
            </calendar>
        </field>
    </record>

    <record id="action_document_document_calendar" model="ir.actions.act_window">
        <field name="name">Agenda Documental</field>
        <field name="res_model">document.document</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="domain">[("agenda_start", "!=", False)]</field>
    </record>

</odoo>
