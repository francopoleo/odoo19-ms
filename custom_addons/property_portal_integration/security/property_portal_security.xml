<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- O portal nunca recebe acesso geral: cada regra limita os registros ao parceiro logado. -->
        <record id="rule_property_contract_portal_own" model="ir.rule">
            <field name="name">Portal: contratos do próprio inquilino</field>
            <field name="model_id" ref="property_core.model_property_contract"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read">True</field>
            <field name="perm_write">False</field>
            <field name="perm_create">False</field>
            <field name="perm_unlink">False</field>
        </record>

        <record id="rule_property_rent_portal_own" model="ir.rule">
            <field name="name">Portal: parcelas do próprio inquilino</field>
            <field name="model_id" ref="property_core.model_property_rent"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read">True</field>
            <field name="perm_write">False</field>
            <field name="perm_create">False</field>
            <field name="perm_unlink">False</field>
        </record>

        <record id="rule_property_asset_portal_owned" model="ir.rule">
            <field name="name">Portal: imóveis do próprio proprietário</field>
            <field name="model_id" ref="property_core.model_property_asset"/>
            <field name="domain_force">[('owner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read">True</field>
            <field name="perm_write">False</field>
            <field name="perm_create">False</field>
            <field name="perm_unlink">False</field>
        </record>
    </data>
</odoo>
