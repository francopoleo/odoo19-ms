<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== Contadores no Home do Portal ===== -->
    <template id="portal_my_home_property" name="Portal: Imóveis"
              inherit_id="portal.portal_my_home">
        <xpath expr="//div[@id='portal_common_category']" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/property_portal_integration/static/img/folder.svg'"/>
                <t t-set="title">Contratos de Locação</t>
                <t t-set="text">Veja seus contratos ativos, histórico e status.</t>
                <t t-set="url" t-value="'/my/contracts'"/>
                <t t-set="count" t-value="contract_count"/>
                <t t-set="show_count" t-value="True"/>
                <t t-set="config_card" t-value="True"/>
            </t>
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/property_portal_integration/static/img/bill.svg'"/>
                <t t-set="title">Parcelas de Aluguel</t>
                <t t-set="text">Acompanhe vencimentos e situação dos seus aluguéis.</t>
                <t t-set="url" t-value="'/my/rents'"/>
                <t t-set="count" t-value="rent_count"/>
                <t t-set="show_count" t-value="True"/>
                <t t-set="config_card" t-value="True"/>
            </t>
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/property_portal_integration/static/img/portal-addresses.svg'"/>
                <t t-set="title">Meus Imóveis</t>
                <t t-set="text">Acompanhe seus imóveis, contratos e resultado financeiro.</t>
                <t t-set="url" t-value="'/my/properties'"/>
                <t t-set="count" t-value="owner_asset_count"/>
                <t t-set="show_count" t-value="True"/>
                <t t-set="config_card" t-value="True"/>
            </t>
        </xpath>
    </template>

    <!-- ===== Portal Proprietário: Lista de Imóveis ===== -->
    <template id="portal_my_properties" name="Meus Imóveis">
        <t t-call="portal.portal_layout">
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Meus Imóveis</t>
            </t>
            <div class="row mb-3">
                <div class="col-md-4">
                    <div class="card border-success">
                        <div class="card-body text-center">
                            <div class="fs-4 fw-bold text-success">
                                <t t-out="len(assets)"/>
                            </div>
                            <div class="text-muted small">Imóveis</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-primary">
                        <div class="card-body text-center">
                            <div class="fs-4 fw-bold text-primary">
                                <t t-out="active_contracts"/>
                            </div>
                            <div class="text-muted small">Contratos Ativos</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-info">
                        <div class="card-body text-center">
                            <div class="fs-4 fw-bold text-info">
                                <t t-out="'R$ {:,.2f}'.format(total_monthly_income).replace(',','X').replace('.',',').replace('X','.')"/>
                            </div>
                            <div class="text-muted small">Receita Mensal</div>
                        </div>
                    </div>
                </div>
            </div>
            <t t-if="not assets">
                <div class="alert alert-info">Nenhum imóvel cadastrado.</div>
            </t>
            <t t-if="assets">
                <div class="row">
                    <t t-foreach="assets" t-as="asset">
                        <div class="col-md-6 mb-3">
                            <a t-attf-href="/my/properties/#{asset.id}" class="text-decoration-none">
                                <div class="card h-100 shadow-sm">
                                    <div class="card-body">
                                        <h5 class="card-title"><t t-out="asset.name"/></h5>
                                        <p class="text-muted small mb-1">
                                            <t t-out="asset.address or ''"/>
                                            <t t-if="asset.city">, <t t-out="asset.city"/></t>
                                        </p>
                                        <div class="d-flex justify-content-between align-items-center mt-2">
                                            <span t-attf-class="badge #{
                                                'bg-success' if asset.status == 'rented' else
                                                'bg-primary' if asset.status == 'available' else
                                                'bg-warning text-dark' if asset.status in ('maintenance','negotiating') else
                                                'bg-secondary'
                                            }">
                                                <t t-out="dict(asset._fields['status'].selection).get(asset.status, asset.status)"/>
                                            </span>
                                            <span class="fw-bold text-success" t-if="asset.current_monthly_rent">
                                                R$ <t t-out="'{:,.2f}'.format(asset.current_monthly_rent).replace(',','X').replace('.',',').replace('X','.')"/>
                                                <small class="text-muted">/mês</small>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    </t>
                </div>
            </t>
        </t>
    </template>

    <!-- ===== Portal Proprietário: Detalhe do Imóvel ===== -->
    <template id="portal_property_detail" name="Detalhe do Imóvel">
        <t t-call="portal.portal_layout">
            <div class="container mt-3">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/my">Portal</a></li>
                        <li class="breadcrumb-item"><a href="/my/properties">Meus Imóveis</a></li>
                        <li class="breadcrumb-item active"><t t-out="asset.name"/></li>
                    </ol>
                </nav>

                <h3><t t-out="asset.name"/></h3>
                <p class="text-muted">
                    <t t-out="asset.address or ''"/>
                    <t t-if="asset.city">, <t t-out="asset.city"/></t>
                </p>

                <div class="row mb-4">
                    <div class="col-md-3">
                        <div class="card text-center border-0 bg-light">
                            <div class="card-body">
                                <div class="fs-5 fw-bold"><t t-out="asset.useful_area or 0"/> m²</div>
                                <small class="text-muted">Área Útil</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card text-center border-0 bg-light">
                            <div class="card-body">
                                <div class="fs-5 fw-bold"><t t-out="asset.bedrooms"/></div>
                                <small class="text-muted">Quartos</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card text-center border-0 bg-light">
                            <div class="card-body">
                                <div class="fs-5 fw-bold text-success">
                                    R$ <t t-out="'{:,.2f}'.format(asset.current_monthly_rent).replace(',','X').replace('.',',').replace('X','.')"/>
                                </div>
                                <small class="text-muted">Aluguel Atual</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card text-center border-0 bg-light">
                            <div class="card-body">
                                <div class="fs-5 fw-bold"><t t-out="asset.active_contract_count"/></div>
                                <small class="text-muted">Contratos Ativos</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Gallery Section -->
                <t t-if="gallery_by_role">
                    <h5 class="mt-5 mb-3">Galeria do Imóvel</h5>
                    <ul class="nav nav-tabs" id="galleryTabs" role="tablist">
                        <t t-foreach="gallery_by_role.items()" t-as="role_item">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" t-att-class="{'active': role_item_index == 0}"
                                        t-att-id="'tab-' + role_item[0].lower().replace(' ', '-')"
                                        t-att-data-bs-target="'#content-' + role_item[0].lower().replace(' ', '-')"
                                        type="button" role="tab" t-att-aria-label="role_item[0]">
                                    <t t-out="role_item[0]"/>
                                </button>
                            </li>
                        </t>
                    </ul>
                    <div class="tab-content mt-3" id="galleryTabContent">
                        <t t-foreach="gallery_by_role.items()" t-as="role_item">
                            <div class="tab-pane fade" t-att-class="{'show active': role_item_index == 0}"
                                 t-att-id="'content-' + role_item[0].lower().replace(' ', '-')"
                                 role="tabpanel">
                                <div class="row g-3">
                                    <t t-foreach="role_item[1]" t-as="media">
                                        <div class="col-md-4 col-lg-3">
                                            <div class="card border-0 shadow-sm overflow-hidden">
                                                <div style="height:180px;overflow:hidden;">
                                                    <img t-attf-src="/web/image/property.media/#{media.id}/image_512"
                                                         class="w-100 h-100"
                                                         style="object-fit:cover;cursor:pointer;"
                                                         data-bs-toggle="modal"
                                                         t-att-data-bs-target="'#modal-' + str(media.id)"
                                                         t-att-alt="media.name"/>
                                                </div>
                                                <div class="card-body py-2">
                                                    <h6 class="card-title text-truncate mb-1"><t t-out="media.name"/></h6>
                                                    <t t-if="media.location_note">
                                                        <small class="text-muted d-block"><t t-out="media.location_note"/></small>
                                                    </t>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Lightbox Modal -->
                                        <div class="modal fade" t-att-id="'modal-' + str(media.id)" tabindex="-1">
                                            <div class="modal-dialog modal-lg modal-dialog-centered">
                                                <div class="modal-content border-0">
                                                    <div class="modal-header border-0 py-2">
                                                        <h5 class="modal-title"><t t-out="media.name"/></h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"/>
                                                    </div>
                                                    <div class="modal-body">
                                                        <img t-attf-src="/web/image/property.media/#{media.id}/image_1920"
                                                             class="w-100"
                                                             t-att-alt="media.name"/>
                                                        <t t-if="media.caption">
                                                            <p class="text-muted mt-3"><t t-out="media.caption"/></p>
                                                        </t>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>

                <t t-if="active_contracts">
                    <h5 class="mt-3">Contratos Ativos</h5>
                    <table class="table table-hover table-sm">
                        <thead class="table-light">
                            <tr>
                                <th>Referência</th>
                                <th>Locatário</th>
                                <th>Início</th>
                                <th>Fim</th>
                                <th>Aluguel</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="active_contracts" t-as="c">
                                <tr>
                                    <td><t t-out="c.reference"/></td>
                                    <td><t t-out="c.partner_id.name"/></td>
                                    <td><t t-out="c.start_date.strftime('%d/%m/%Y')"/></td>
                                    <td><t t-out="c.end_date.strftime('%d/%m/%Y')"/></td>
                                    <td>R$ <t t-out="'{:,.2f}'.format(c.monthly_rent).replace(',','X').replace('.',',').replace('X','.')"/></td>
                                    <td>
                                        <span t-attf-class="badge #{
                                            'bg-success' if c.status == 'active' else
                                            'bg-warning text-dark' if c.status in ('expiring','renewing') else
                                            'bg-secondary'
                                        }">
                                            <t t-out="dict(c._fields['status'].selection).get(c.status, c.status)"/>
                                        </span>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>
            </div>
        </t>
    </template>

    <!-- ===== Lista de Contratos ===== -->
    <template id="portal_my_contracts" name="Meus Contratos">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Contratos de Locação</t>
            </t>
            <t t-if="not contracts">
                <div class="alert alert-info">
                    Nenhum contrato encontrado.
                </div>
            </t>
            <t t-if="contracts">
                <div class="card shadow-sm mb-4">
                    <div class="card-body p-0">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Referência</th>
                                    <th>Imóvel</th>
                                    <th>Início</th>
                                    <th>Fim</th>
                                    <th>Aluguel</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="contracts" t-as="contract">
                                    <tr>
                                        <td>
                                            <span class="text-muted small">
                                                <t t-out="contract.reference"/>
                                            </span>
                                        </td>
                                        <td>
                                            <strong><t t-out="contract.asset_id.name"/></strong>
                                            <div class="text-muted small">
                                                <t t-out="contract.asset_id.city"/>
                                            </div>
                                        </td>
                                        <td><t t-out="contract.start_date"/></td>
                                        <td><t t-out="contract.end_date"/></td>
                                        <td>
                                            <strong>
                                                <t t-out="contract.monthly_rent"
                                                   t-options='{"widget": "monetary", "display_currency": contract.currency_id}'/>
                                            </strong>
                                        </td>
                                        <td>
                                            <t t-if="contract.status == 'active'">
                                                <span class="badge text-bg-success">Ativo</span>
                                            </t>
                                            <t t-elif="contract.status == 'expiring'">
                                                <span class="badge text-bg-warning">A Vencer</span>
                                            </t>
                                            <t t-elif="contract.status == 'late'">
                                                <span class="badge text-bg-danger">Vencido</span>
                                            </t>
                                            <t t-elif="contract.status == 'defaulting'">
                                                <span class="badge text-bg-danger">Inadimplente</span>
                                            </t>
                                            <t t-elif="contract.status == 'renewing'">
                                                <span class="badge text-bg-info">Em Renovação</span>
                                            </t>
                                            <t t-else="">
                                                <span class="badge text-bg-secondary">
                                                    <t t-out="contract.status"/>
                                                </span>
                                            </t>
                                        </td>
                                        <td>
                                            <a t-attf-href="/my/contracts/#{contract.id}"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="fa fa-eye me-1"/>Ver
                                            </a>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="d-flex justify-content-center">
                    <t t-call="portal.pager"/>
                </div>
            </t>
        </t>
    </template>

    <!-- ===== Detalhe do Contrato ===== -->
    <template id="portal_contract_detail" name="Detalhe do Contrato">
        <t t-call="portal.portal_layout">
            <t t-set="o_portal_fullwidth_alert" t-if="contract.status in ('late','defaulting')">
                <t t-call="portal.portal_back_in_edit_mode">
                    <t t-set="backend_url"
                       t-value="'/web#model=property.contract&amp;id=%s&amp;view_type=form' % contract.id"/>
                </t>
            </t>

            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/my">Minha Conta</a></li>
                    <li class="breadcrumb-item"><a href="/my/contracts">Contratos</a></li>
                    <li class="breadcrumb-item active">
                        <t t-out="contract.reference"/>
                    </li>
                </ol>
            </nav>

            <!-- Header do Contrato -->
            <div class="card shadow-sm mb-4">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="mb-0">
                            <i class="fa fa-file-text-o me-2 text-primary"/>
                            <t t-out="contract.name"/>
                        </h5>
                        <small class="text-muted"><t t-out="contract.reference"/></small>
                    </div>
                    <t t-if="contract.status == 'active'">
                        <span class="badge text-bg-success fs-6">Ativo</span>
                    </t>
                    <t t-elif="contract.status == 'expiring'">
                        <span class="badge text-bg-warning fs-6">A Vencer</span>
                    </t>
                    <t t-elif="contract.status in ('late','defaulting')">
                        <span class="badge text-bg-danger fs-6">Inadimplente</span>
                    </t>
                </div>
                <div class="card-body">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <h6 class="text-muted fw-bold text-uppercase mb-3"
                                style="font-size:11px;letter-spacing:1px">Imóvel</h6>
                            <div class="d-flex gap-3 align-items-start">
                                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                                     style="width:44px;height:44px;background:#0d6efd22">
                                    <i class="fa fa-building text-primary"/>
                                </div>
                                <div>
                                    <div class="fw-bold">
                                        <t t-out="contract.asset_id.name"/>
                                    </div>
                                    <div class="text-muted small">
                                        <t t-out="contract.asset_id.address"/>
                                        <t t-if="contract.asset_id.address_number">
                                            , <t t-out="contract.asset_id.address_number"/>
                                        </t>
                                    </div>
                                    <div class="text-muted small">
                                        <t t-out="contract.asset_id.neighborhood"/> —
                                        <t t-out="contract.asset_id.city"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <h6 class="text-muted fw-bold text-uppercase mb-3"
                                style="font-size:11px;letter-spacing:1px">Vigência</h6>
                            <div><i class="fa fa-calendar me-1 text-muted"/>
                                <t t-out="contract.start_date"/> a <t t-out="contract.end_date"/>
                            </div>
                            <div class="text-muted small mt-1">
                                <t t-out="contract.duration_months"/> meses
                            </div>
                        </div>
                        <div class="col-md-3">
                            <h6 class="text-muted fw-bold text-uppercase mb-3"
                                style="font-size:11px;letter-spacing:1px">Valores</h6>
                            <div class="fs-5 fw-bold text-success">
                                <t t-out="contract.monthly_rent"
                                   t-options='{"widget": "monetary", "display_currency": contract.currency_id}'/>
                            </div>
                            <div class="text-muted small">por mês</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Property Cover Image -->
            <t t-if="cover_media">
                <div class="card shadow-sm mb-4 overflow-hidden">
                    <img t-attf-src="/web/image/property.media/#{cover_media.id}/image_1920"
                         class="w-100"
                         style="height:300px;object-fit:cover;"/>
                </div>
            </t>

            <!-- Parcelas -->
            <h6 class="fw-bold text-uppercase text-muted mb-3"
                style="font-size:11px;letter-spacing:1px">
                <i class="fa fa-list me-1"/>Parcelas de Aluguel
            </h6>
            <div class="card shadow-sm mb-4">
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Competência</th>
                                <th>Vencimento</th>
                                <th>Valor</th>
                                <th>Pago em</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="rents" t-as="rent">
                                <tr>
                                    <td>
                                        <t t-out="'%02d/%d' % (rent.competence_month, rent.competence_year)"
                                           t-if="rent.competence_month"/>
                                    </td>
                                    <td>
                                        <t t-out="rent.due_date"/>
                                        <t t-if="rent.status == 'late'">
                                            <span class="badge text-bg-danger ms-1">
                                                <t t-out="rent.days_late"/>d
                                            </span>
                                        </t>
                                    </td>
                                    <td>
                                        <t t-out="rent.amount_due"
                                           t-options='{"widget": "monetary", "display_currency": rent.currency_id}'/>
                                    </td>
                                    <td>
                                        <t t-out="rent.payment_date or ''"/>
                                    </td>
                                    <td>
                                        <t t-if="rent.status == 'paid'">
                                            <span class="badge text-bg-success">Pago</span>
                                        </t>
                                        <t t-elif="rent.status == 'late'">
                                            <span class="badge text-bg-danger">Atrasado</span>
                                        </t>
                                        <t t-elif="rent.status == 'partial'">
                                            <span class="badge text-bg-warning">Parcial</span>
                                        </t>
                                        <t t-elif="rent.status == 'open'">
                                            <span class="badge text-bg-secondary">Em Aberto</span>
                                        </t>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Documentos do contrato -->
            <t t-if="documents">
                <h6 class="fw-bold text-uppercase text-muted mb-3"
                    style="font-size:11px;letter-spacing:1px">
                    <i class="fa fa-file-o me-1"/>Documentos
                </h6>
                <div class="row g-3 mb-4">
                    <t t-foreach="documents" t-as="doc">
                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body d-flex align-items-center gap-3">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                                         style="width:40px;height:40px;background:#0d6efd22">
                                        <i class="fa fa-file-text-o text-primary"/>
                                    </div>
                                    <div>
                                        <div class="fw-bold small"><t t-out="doc.name"/></div>
                                        <div class="text-muted" style="font-size:11px">
                                            <t t-out="doc.document_type_id.display_name or '-'"/>
                                            <t t-if="doc.expiry_date">
                                                — vence <t t-out="doc.expiry_date"/>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </t>
        </t>
    </template>

    <!-- ===== Lista de Parcelas ===== -->
    <template id="portal_my_rents" name="Minhas Parcelas">
        <t t-call="portal.portal_layout">
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Parcelas de Aluguel</t>
            </t>
            <t t-if="not rents">
                <div class="alert alert-info">Nenhuma parcela encontrada.</div>
            </t>
            <t t-if="rents">
                <div class="card shadow-sm mb-4">
                    <div class="card-body p-0">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Referência</th>
                                    <th>Imóvel</th>
                                    <th>Competência</th>
                                    <th>Vencimento</th>
                                    <th>Valor</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="rents" t-as="rent">
                                    <tr t-attf-class="#{rent.status == 'late' and 'table-danger' or rent.status == 'paid' and 'table-success' or ''}">
                                        <td class="text-muted small">
                                            <t t-out="rent.reference"/>
                                        </td>
                                        <td>
                                            <strong><t t-out="rent.asset_id.name"/></strong>
                                        </td>
                                        <td>
                                            <t t-if="rent.competence_month">
                                                <t t-out="'%02d/%d' % (rent.competence_month, rent.competence_year)"/>
                                            </t>
                                        </td>
                                        <td>
                                            <t t-out="rent.due_date"/>
                                            <t t-if="rent.status == 'late'">
                                                <span class="badge text-bg-danger ms-1">
                                                    +<t t-out="rent.days_late"/>d
                                                </span>
                                            </t>
                                        </td>
                                        <td>
                                            <strong>
                                                <t t-out="rent.amount_due"
                                                   t-options='{"widget": "monetary", "display_currency": rent.currency_id}'/>
                                            </strong>
                                        </td>
                                        <td>
                                            <t t-if="rent.status == 'paid'">
                                                <span class="badge text-bg-success">Pago</span>
                                            </t>
                                            <t t-elif="rent.status == 'late'">
                                                <span class="badge text-bg-danger">Atrasado</span>
                                            </t>
                                            <t t-elif="rent.status == 'partial'">
                                                <span class="badge text-bg-warning">Parcial</span>
                                            </t>
                                            <t t-else="">
                                                <span class="badge text-bg-secondary">Em Aberto</span>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="d-flex justify-content-center">
                    <t t-call="portal.pager"/>
                </div>
            </t>
        </t>
    </template>

</odoo>
