<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_condominium_return_wizard_form" model="ir.ui.view">
        <field name="name">property.condominium.return.wizard.form</field>
        <field name="model">property.condominium.return.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="data_file"/>
                        <field name="filename"/>
                    </group>
                    <footer>
                        <button name="action_import_return" type="object" string="Importar Retorno" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_property_condominium_return_wizard" model="ir.actions.act_window">
        <field name="name">Importar Retorno</field>
        <field name="res_model">property.condominium.return.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
