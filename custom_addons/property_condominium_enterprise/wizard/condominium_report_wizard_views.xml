<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_condominium_report_wizard_form" model="ir.ui.view">
        <field name="name">property.condominium.report.wizard.form</field>
        <field name="model">property.condominium.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Resumo do Condomínio">
                <sheet>
                    <group>
                        <field name="report_type"/>
                        <field name="complex_id"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_open_report" type="object" string="Abrir Resumo" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_property_condominium_report_wizard" model="ir.actions.act_window">
        <field name="name">Resumo</field>
        <field name="res_model">property.condominium.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
