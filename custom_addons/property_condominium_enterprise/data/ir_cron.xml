<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_generate_condominium_charges" model="ir.cron">
        <field name="name">Generate Condominium Charges</field>
        <field name="model_id" ref="model_property_condominium_charge"/>
        <field name="state">code</field>
        <field name="code">model.action_generate_monthly_charges()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="nextcall" eval="(DateTime.now())"/>
        <field name="active">False</field>
    </record>
</odoo>
