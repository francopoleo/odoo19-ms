<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_complex_condo_form_ext" model="ir.ui.view">
        <field name="name">property.complex.condo.form.ext</field>
        <field name="model">property.complex</field>
        <field name="inherit_id" ref="property_core.view_property_complex_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_generate_condominium_charges" type="object" class="oe_stat_button" icon="fa-bolt">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Gerar Cobranças</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//notebook" position="before">
                <group string="Condomínio / Mall">
                    <field name="complex_mode"/>
                    <field name="condo_active"/>
                    <field name="condo_manager_id"/>
                    <field name="condo_rent_day"/>
                    <field name="condo_fee_amount"/>
                    <field name="common_area_budget"/>
                    <field name="common_area_rateio_key"/>
                    <field name="cnab_profile_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
