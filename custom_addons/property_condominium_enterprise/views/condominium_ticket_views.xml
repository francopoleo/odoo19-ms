<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_condominium_ticket_list" model="ir.ui.view">
        <field name="name">property.condominium.ticket.list</field>
        <field name="model">property.condominium.ticket</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="complex_id"/>
                <field name="unit_id"/>
                <field name="partner_id"/>
                <field name="category"/>
                <field name="priority"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_property_condominium_ticket_form" model="ir.ui.view">
        <field name="name">property.condominium.ticket.form</field>
        <field name="model">property.condominium.ticket</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="complex_id"/>
                        <field name="unit_id"/>
                        <field name="partner_id"/>
                        <field name="category"/>
                        <field name="priority"/>
                        <field name="state"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_property_condominium_ticket" model="ir.actions.act_window">
        <field name="name">Chamados</field>
        <field name="res_model">property.condominium.ticket</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
