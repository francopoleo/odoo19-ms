<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_property_condominium" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.property.condominium</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='property_rent_settings']" position="inside">
                <setting string="Condomínio" help="Configurações contábeis padrão para as operações do condomínio, incluindo boletos e baixas.">
                    <group>
                        <field name="property_condominium_journal_id"/>
                        <field name="property_condominium_income_account_id"/>
                    </group>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
