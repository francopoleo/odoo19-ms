<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_contract_form_dossier_ext" model="ir.ui.view">
        <field name="name">property.contract.form.dossier.ext</field>
        <field name="model">property.contract</field>
        <field name="inherit_id" ref="property_core.view_property_contract_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_assign_dossier_template" type="object" class="oe_stat_button" icon="fa-folder-plus" groups="document_dossier.group_dossier_operator">
                    <span>Atribuir Dossiê</span>
                </button>
                <button name="action_view_dossier" type="object" class="oe_stat_button" icon="fa-folder-open" invisible="not dossier_id" groups="document_dossier.group_dossier_operator">
                    <field string="Docs. Dossiê" name="dossier_document_count" widget="statinfo"/>
                </button>
                <button name="action_create_collection_dossier" type="object" class="oe_stat_button" icon="fa-money" groups="document_dossier.group_dossier_operator">
                    <span>Abrir Cobrança</span>
                </button>
                <button name="action_create_eviction_dossier" type="object" class="oe_stat_button" icon="fa-gavel" groups="document_dossier.group_dossier_operator">
                    <span>Abrir Despejo</span>
                </button>
                <button name="action_create_renewal_dossier" type="object" class="oe_stat_button" icon="fa-refresh" groups="document_dossier.group_dossier_operator">
                    <span>Abrir Renovação</span>
                </button>
            </xpath>
            <xpath expr="//notebook/page[1]" position="after">
                <page string="Dossiê" groups="document_dossier.group_dossier_operator">
                    <div invisible="dossier_id" class="alert alert-info" role="alert">
                        Nenhum dossiê atribuído. Use o botão <strong>Atribuir Dossiê</strong> no topo do contrato.
                    </div>
                    <group invisible="not dossier_id">
                        <group>
                            <field name="dossier_id" readonly="1"/>
                            <field name="dossier_completion_percent" widget="percentpie" readonly="1"/>
                        </group>
                        <group>
                            <field name="dossier_complete" readonly="1"/>
                            <field name="dossier_missing_requirements" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_property_contract_list_dossier_ext" model="ir.ui.view">
        <field name="name">property.contract.list.dossier.ext</field>
        <field name="model">property.contract</field>
        <field name="inherit_id" ref="property_core.view_property_contract_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='status']" position="after">
                <field name="dossier_id" optional="hide"/>
                <field name="dossier_completion_percent" optional="hide" widget="percentpie"/>
            </xpath>
        </field>
    </record>
</odoo>
