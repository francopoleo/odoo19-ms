<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="privilege_property" model="res.groups.privilege">
            <field name="name">Imóveis</field>
            <field name="sequence" eval="30"/>
            <field name="category_id" ref="common_base.module_category_realestate"/>
        </record>

        <record id="group_property_user" model="res.groups">
            <field name="name">Usuário de Imóveis</field>
            <field name="privilege_id" ref="property_core.privilege_property"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_property_manager" model="res.groups">
            <field name="name">Gestor de Imóveis</field>
            <field name="privilege_id" ref="property_core.privilege_property"/>
