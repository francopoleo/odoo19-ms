<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_stakeholder_profile_list" model="ir.ui.view">
        <field name="name">property.stakeholder.profile.list</field><field name="model">property.stakeholder.profile</field>
        <field name="arch" type="xml">
            <list>
                <field name="display_name"/>
                <field name="partner_id"/>
                <field name="stakeholder_type_id" string="Perfil / Papel"/>
                <field name="role_status" widget="badge"/>
                <field name="user_id"/>
                <field name="brokerage_profile_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_property_stakeholder_profile_form" model="ir.ui.view">
        <field name="name">property.stakeholder.profile.form</field><field name="model">property.stakeholder.profile</field>
        <field name="arch" type="xml">
            <form>
                <header><field name="role_status" widget="statusbar" statusbar_visible="draft,active,inactive,blocked"/></header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_partner" type="object" class="oe_stat_button" icon="fa-address-book-o" help="Abra o contato mestre da pessoa ou empresa vinculada a este perfil.">
                            <span class="o_stat_text">Abrir Contato Mestre</span>
                        </button>
                    </div>
                    <div class="alert alert-info" role="alert">
                        <strong>Perfil imobiliário:</strong> esta tela representa o <strong>papel</strong> do contato dentro do negócio imobiliário. O cadastro principal da pessoa ou empresa continua em <strong>Contatos</strong>.
                    </div>
                    <group>
                        <group string="Contato e Papel">
                            <field name="partner_id" options="{'no_open': False}"/>
                            <field name="stakeholder_type_id"/>
                            <field name="user_id"/>
                            <field name="brokerage_profile_id"/>
                        </group>
                        <group string="Controle do Perfil">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="registration_number"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Orientações e Observações"><field name="notes" nolabel="1" placeholder="Ex.: este contato atua como corretor parceiro, vinculado à imobiliária X, com comissão negociada em contrato específico."/></group>
                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_property_stakeholder_profile" model="ir.actions.act_window">
        <field name="name">Perfis Imobiliários</field><field name="res_model">property.stakeholder.profile</field><field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crie perfis imobiliários para contatos já cadastrados.</p>
            <p>O contato é o cadastro mestre da pessoa ou empresa. O perfil define o papel exercido no contexto imobiliário.</p>
        </field>
    </record>
</odoo>