<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== property.index LIST ==================== -->
    <record id="view_property_index_list" model="ir.ui.view">
        <field name="name">property.index.list</field>
        <field name="model">property.index</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="bcb_series_code"/>
                <field name="value_count" string="Registros"/>
                <field name="last_sync"/>
            </list>
        </field>
    </record>

    <!-- ==================== property.index FORM ==================== -->
    <record id="view_property_index_form" model="ir.ui.view">
        <field name="name">property.index.form</field>
        <field name="model">property.index</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_sync_from_bcb" type="object"
                            string="Sincronizar com BCB"
                            class="btn-primary"
                            confirm="Buscar dados do Banco Central (api.bcb.gov.br) conforme o período configurado?"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Identificação">
                            <field name="code"/>
                            <field name="bcb_series_code" readonly="1"/>
                        </group>
                        <group string="Sincronização">
                            <field name="months_back"/>
                            <field name="last_sync" readonly="1"/>
                        </group>
                        <group string="Dados disponíveis">
                            <label for="coverage_from" string="Cobertura"/>
                            <div>
                                <field name="coverage_from" readonly="1" nolabel="1" class="o_field_widget"/>
                                <span> a </span>
                                <field name="coverage_to" readonly="1" nolabel="1" class="o_field_widget"/>
                            </div>
                            <field name="value_count" readonly="1" string="Total de meses"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Valores Mensais">
                            <field name="value_ids">
                                <list editable="bottom">
                                    <field name="year"/>
                                    <field name="month"/>
                                    <field name="month_label" readonly="1" string="Período"/>
                                    <field name="value_pct" string="Variação (%)"/>
                                </list>
                            </field>
                        </page>
                        <page string="Comunicações">
                            <chatter/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ==================== ACTION ==================== -->
    <record id="action_property_index" model="ir.actions.act_window">
        <field name="name">Índices de Reajuste</field>
        <field name="res_model">property.index</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Cadastre os índices IGP-M, IPCA e INPC e sincronize com o Banco Central.
            </p>
        </field>
    </record>

</odoo>