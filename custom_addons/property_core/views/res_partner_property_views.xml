<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== FORM EXTENSION ==================== -->
    <record id="view_res_partner_form_property_ext" model="ir.ui.view">
        <field name="name">res.partner.form.property.ext</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <sheet position="inside">
                <notebook position="inside">
                    <page name="property_roles" string="Papéis Imobiliários" invisible="not has_property_roles">
                        <div class="alert alert-info" role="alert">
                            <i class="fa fa-building me-2"/>
                            <span>Este contato tem papéis no módulo imobiliário.</span>
                        </div>

                        <group name="property_identification" string="Identificação Imobiliária">
                            <field name="property_role_ids" widget="many2many_tags" readonly="1"/>
                            <field name="cpf_cnpj"/>
                            <field name="mobile"/>
                        </group>

                        <!-- CORRETOR -->
                        <group name="property_broker" string="Dados de Corretor" invisible="not has_role_broker">
                            <field name="creci"/>
                            <field name="commission_rate"/>
                        </group>

                        <!-- PROPRIETÁRIO -->
                        <group name="property_owner" string="Dados Bancários" invisible="not has_role_owner">
                            <field name="bank_name"/>
                            <field name="bank_agency"/>
                            <field name="bank_account"/>
                        </group>

                        <!-- COMPRADOR / VENDEDOR -->
                        <group name="property_buyer_seller" string="Orçamento" invisible="not (has_role_buyer or has_role_seller)">
                            <field name="budget_min" invisible="not has_role_buyer"/>
                            <field name="budget_max" invisible="not has_role_buyer"/>
                            <field name="currency_id" invisible="not has_role_buyer"/>
                        </group>

                        <!-- INVESTIDOR -->
                        <group name="property_investor" string="Perfil de Investimento" invisible="not has_role_investor">
                            <field name="investment_profile"/>
                        </group>
                    </page>
                </notebook>
            </sheet>
        </field>
    </record>

    <!-- ==================== PROPRIETÁRIOS (FILTERED VIEW) ==================== -->

    <record id="view_res_partner_list_property_owner" model="ir.ui.view">
        <field name="name">res.partner.list.property.owner</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="mobile"/>
                <field name="cpf_cnpj"/>
            </list>
        </field>
    </record>

    <record id="action_res_partner_property_owner" model="ir.actions.act_window">
        <field name="name">Proprietários</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[("category_id", "ilike", "Proprietário")]</field>
        <field name="context">{"default_category_id": [(4, ref('res_partner_category_property_owner'))]}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Cadastre seu primeiro proprietário!</p>
        </field>
    </record>

