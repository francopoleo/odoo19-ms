<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== LIST ==================== -->
    <record id="view_property_acquisition_list" model="ir.ui.view">
        <field name="name">property.acquisition.list</field>
        <field name="model">property.acquisition</field>
        <field name="arch" type="xml">
            <list decoration-success="stage == 'closed'"
                  decoration-warning="stage in ('negotiation','closing')"
                  decoration-muted="stage == 'cancelled'">
                <field name="reference"/>
                <field name="name"/>
                <field name="priority" widget="priority"/>
                <field name="asset_type"/>
                <field name="city"/>
                <field name="seller_partner_id"/>
                <field name="asking_price"/>
                <field name="agreed_price"/>
                <field name="total_investment"/>
                <field name="roi_annual" string="ROI %"/>
                <field name="expected_close_date"/>
                <field name="responsible_id"/>
                <field name="stage" widget="badge"
                       decoration-info="stage == 'prospecting'"
                       decoration-warning="stage in ('analysis','negotiation','due_diligence','closing')"
                       decoration-success="stage == 'closed'"
                       decoration-muted="stage == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- ==================== KANBAN ==================== -->
    <record id="view_property_acquisition_kanban" model="ir.ui.view">
        <field name="name">property.acquisition.kanban</field>
        <field name="model">property.acquisition</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage" group_create="false"
                    class="o_kanban_small_column">
                <field name="stage"/>
                <field name="priority"/>
                <field name="color"/>
                <field name="asking_price"/>
                <field name="agreed_price"/>
                <field name="roi_annual"/>
                <field name="expected_close_date"/>
                <field name="responsible_id"/>
                <field name="asset_type"/>
                <field name="city"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_color_#{record.color.raw_value}">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <small class="text-muted">
                                        <field name="reference"/>
                                    </small>
                                </div>
                                <field name="priority" widget="priority"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>
                                    <i class="fa fa-map-marker me-1" title="Cidade"/>
                                    <field name="city"/>
                                    <span t-if="record.asset_type.raw_value" class="ms-2 badge text-bg-secondary">
                                        <field name="asset_type"/>
                                    </span>
                                </div>
                                <div t-if="record.agreed_price.raw_value" class="mt-1">
                                    <i class="fa fa-tag me-1 text-success" title="Preço acordado"/>
                                    <strong><field name="agreed_price" widget="monetary"/></strong>
                                    <span t-if="record.roi_annual.raw_value" class="ms-2 text-muted">
                                        ROI: <field name="roi_annual"/>%
                                    </span>
                                </div>
                                <div t-elif="record.asking_price.raw_value" class="mt-1 text-muted">
                                    <i class="fa fa-tag me-1" title="Preço solicitado"/>
                                    <field name="asking_price" widget="monetary"/>
                                </div>
                                <div t-if="record.expected_close_date.raw_value" class="mt-1">
                                    <i class="fa fa-calendar me-1 text-warning" title="Data prevista de fechamento"/>
                                    <field name="expected_close_date"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="responsible_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ==================== FORM ==================== -->
    <record id="view_property_acquisition_form" model="ir.ui.view">
        <field name="name">property.acquisition.form</field>
        <field name="model">property.acquisition</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_set_analysis" type="object" string="Iniciar Análise"
                            invisible="stage != 'prospecting'" class="btn-primary"/>
                    <button name="action_set_negotiation" type="object" string="Iniciar Negociação"
                            invisible="stage != 'analysis'" class="btn-primary"/>
                    <button name="action_set_due_diligence" type="object" string="Due Diligence"
                            invisible="stage != 'negotiation'" class="btn-primary"/>
                    <button name="action_set_closing" type="object" string="Ir para Fechamento"
                            invisible="stage != 'due_diligence'" class="btn-primary"/>
                    <button name="action_close" type="object" string="Fechar Negócio e Criar Imóvel"
                            invisible="stage != 'closing'" class="btn-success"/>
                    <button name="action_cancel" type="object" string="Cancelar"
                            invisible="stage in ['closed','cancelled']"/>
                    <button name="action_reset" type="object" string="Reabrir"
                            invisible="stage != 'cancelled'"/>
                    <field name="stage" widget="statusbar"
                           statusbar_visible="prospecting,analysis,negotiation,due_diligence,closing,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_asset" type="object"
                                class="oe_stat_button" icon="fa-building"
                                invisible="not asset_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Ver Imóvel</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nome da oportunidade..."/>
                        </h1>
                        <div class="o_row">
                            <field name="reference" readonly="1" class="text-muted"/>
                            <field name="priority" widget="priority" class="ms-3"/>
                        </div>
                    </div>

                    <group>
                        <group string="Imóvel">
                            <field name="asset_type"/>
                            <field name="address"/>
                            <field name="neighborhood"/>
                            <field name="city"/>
                            <field name="state_name"/>
                            <field name="zip_code" onchange="_onchange_zip_code" help="Digite o CEP (8 dígitos) para buscar dados automaticamente"/>
                            <field name="total_area"/>
                            <field name="useful_area"/>
                        </group>
                        <group>
                            <button name="action_search_zip_code" type="object" string="🔍 Buscar CEP"
                                    class="btn-link" help="Busca dados de endereço pelo CEP (ViaCEP)"/>
                        </group>
                        <group string="Partes">
                            <field name="seller_partner_id"/>
                            <field name="broker_id"/>
                            <field name="responsible_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>

                    <group string="Análise Financeira">
                        <group string="Preços">
                            <field name="currency_id" invisible="1"/>
                            <field name="asking_price"/>
                            <field name="offer_price"/>
                            <field name="agreed_price"/>
                            <field name="discount_pct" readonly="1" string="Desconto Obtido (%)"/>
                        </group>
                        <group string="Retorno">
                            <field name="estimated_renovation"/>
                            <field name="total_investment" readonly="1"/>
                            <field name="estimated_rent"/>
                            <field name="roi_annual" readonly="1" string="ROI Anual (%)"/>
                        </group>
                    </group>

                    <group string="Datas">
                        <group>
                            <field name="prospect_date"/>
                            <field name="expected_close_date"/>
                            <field name="close_date" readonly="1"
                                   invisible="stage != 'closed'"/>
                        </group>
                    </group>

                    <group string="Due Diligence" invisible="stage not in ['due_diligence','closing','closed']">
                        <group string="Checklist">
                            <field name="dd_legal_docs"/>
                            <field name="dd_registration"/>
                            <field name="dd_iptu_clear"/>
                            <field name="dd_environmental"/>
                            <field name="dd_structural"/>
                        </group>
                        <group string="Progresso">
                            <field name="dd_progress" widget="progressbar" readonly="1" nolabel="1"/>
                        </group>
                    </group>

                    <group string="Observações de Due Diligence"
                           invisible="stage not in ['due_diligence','closing','closed']">
                        <field name="dd_notes" nolabel="1"/>
                    </group>

                    <group string="Descrição do Imóvel">
                        <field name="description" nolabel="1"/>
                    </group>

                    <group string="Notas">
                        <field name="notes" nolabel="1"/>
                    </group>

                    <notebook>
                        <page string="Comunicações">
                            <chatter/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ==================== SEARCH ==================== -->
    <record id="view_property_acquisition_search" model="ir.ui.view">
        <field name="name">property.acquisition.search</field>
        <field name="model">property.acquisition</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="reference"/>
                <field name="city"/>
                <field name="seller_partner_id"/>
                <field name="responsible_id"/>
                <filter string="Ativas" name="active"
                        domain="[('stage','not in',['closed','cancelled'])]"/>
                <filter string="Urgentes" name="urgent"
                        domain="[('priority','=','2')]"/>
                <filter string="Due Diligence" name="dd"
                        domain="[('stage','=','due_diligence')]"/>
                <filter string="Fechamento" name="closing"
                        domain="[('stage','=','closing')]"/>
                <filter string="Concluídas" name="closed"
                        domain="[('stage','=','closed')]"/>
                <separator/>
                <filter string="Por Estágio" name="group_stage" context="{'group_by':'stage'}"/>
                <filter string="Por Tipo" name="group_type" context="{'group_by':'asset_type'}"/>
                <filter string="Por Cidade" name="group_city" context="{'group_by':'city'}"/>
                <filter string="Por Responsável" name="group_resp" context="{'group_by':'responsible_id'}"/>
            </search>
        </field>
    </record>

    <!-- ==================== PIVOT ==================== -->
    <record id="view_property_acquisition_pivot" model="ir.ui.view">
        <field name="name">property.acquisition.pivot</field>
        <field name="model">property.acquisition</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="asset_type" type="row"/>
                <field name="stage" type="col"/>
                <field name="total_investment" type="measure"/>
                <field name="agreed_price" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ==================== ACTION ==================== -->
    <record id="action_property_acquisition" model="ir.actions.act_window">
        <field name="name">Pipeline de Aquisição</field>
        <field name="res_model">property.acquisition</field>
        <field name="view_mode">kanban,list,form,pivot</field>
        <field name="context">{"search_default_active": 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Cadastre a primeira oportunidade de aquisição!</p>
        </field>
    </record>

</odoo>