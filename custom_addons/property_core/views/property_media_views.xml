<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="view_property_media_list" model="ir.ui.view">
        <field name="name">property.media.list</field>
        <field name="model">property.media</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="purpose"/>
                <field name="category_id"/>
                <field name="content_kind"/>
                <field name="asset_id"/>
                <field name="inspection_id" optional="show"/>
                <field name="maintenance_id" optional="show"/>
                <field name="visibility_level"/>
                <field name="website_published"/>
                <field name="publication_state"/>
                <field name="is_cover"/>
                <field name="file_size_human" optional="show"/>
                <field name="date_taken" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_property_media_form" model="ir.ui.view">
        <field name="name">property.media.form</field>
        <field name="model">property.media</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Classificação">
                            <field name="purpose"/>
                            <field name="category_id" options="{'no_create_edit': False}"/>
                            <field name="content_kind"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Publicação e Acesso">
                            <field name="visibility_level"/>
                            <field name="website_published" readonly="purpose != 'asset_gallery'"/>
                            <field name="publication_state" readonly="purpose != 'asset_gallery'"/>
                            <field name="is_cover" invisible="purpose != 'asset_gallery' or content_kind != 'image'"/>
                            <field name="allow_download"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Vínculos">
                        <group>
                            <field name="asset_id" required="purpose in ['asset_gallery', 'other']"/>
                            <field name="inspection_id" required="purpose == 'inspection'" invisible="purpose != 'inspection'"/>
                        </group>
                        <group>
                            <field name="maintenance_id" required="purpose == 'maintenance'" invisible="purpose != 'maintenance'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>

                    <group string="Foto / Imagem" invisible="content_kind != 'image'">
                        <field name="image_1920" widget="image" options="{'size': [512, 512]}" nolabel="1"/>
                    </group>

                    <group string="Arquivo / Documento" invisible="content_kind != 'document'">
                        <field name="file_name" placeholder="Nome original do arquivo"/>
                        <field name="file_data" filename="file_name"/>
                    </group>

                    <group string="Metadados">
                        <group>
                            <field name="file_mimetype" readonly="1"/>
                            <field name="file_size_human" readonly="1"/>
                            <field name="file_size" readonly="1" widget="integer"/>
                        </group>
                        <group>
                            <field name="date_taken"/>
                            <field name="taken_by"/>
                        </group>
                    </group>
                    <group>
                        <field name="caption"/>
                        <field name="location_note"/>
                        <field name="tag_ids" widget="many2many_tags"/>
                    </group>
                    <group string="Descrição">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_property_media_kanban" model="ir.ui.view">
        <field name="name">property.media.kanban</field>
        <field name="model">property.media</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small">
                <field name="id"/>
                <field name="name"/>
                <field name="image_512"/>
                <field name="is_cover"/>
                <field name="purpose"/>
                <field name="category_id"/>
                <field name="content_kind"/>
                <field name="website_published"/>
                <field name="publication_state"/>
                <field name="file_name"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click position-relative h-100">
                            <t t-if="record.image_512.raw_value">
                                <img t-attf-src="/web/image/property.media/#{record.id.raw_value}/image_512" alt="Mídia" style="width:100%; height:150px; object-fit:cover; display:block;"/>
                            </t>
                            <t t-else="">
                                <div style="width:100%; height:150px; background:#f0f0f0; display:flex; align-items:center; justify-content:center;">
                                    <i class="fa fa-file" title="Arquivo" style="font-size:32px; color:#ccc;"/>
                                </div>
                            </t>
                            <div class="oe_kanban_details pt-2 px-2">
                                <h6 class="mb-1"><span t-esc="record.name.value" class="text-truncate"/></h6>
                                <div class="small text-muted mb-2">
                                    <span t-esc="record.purpose.value"/>
                                    <t t-if="record.category_id.value"> • <span t-esc="record.category_id.value"/></t>
                                </div>
                                <div class="mt-2">
                                    <t t-if="record.is_cover.raw_value"><span class="badge bg-warning text-dark">★ Capa</span></t>
                                    <t t-if="record.website_published.raw_value"><span class="badge bg-success">Site</span></t>
                                    <t t-if="record.content_kind.raw_value == 'document'"><span class="badge bg-secondary">Arquivo</span></t>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_property_media_search" model="ir.ui.view">
        <field name="name">property.media.search</field>
        <field name="model">property.media</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="asset_id"/>
                <field name="inspection_id"/>
                <field name="maintenance_id"/>
                <field name="category_id"/>
                <filter string="Galeria" name="asset_gallery" domain="[('purpose','=','asset_gallery')]"/>
                <filter string="Vistoria" name="inspection" domain="[('purpose','=','inspection')]"/>
                <filter string="Manutenção" name="maintenance" domain="[('purpose','=','maintenance')]"/>
                <filter string="Outras Mídias" name="other" domain="[('purpose','=','other')]"/>
                <filter string="Publicadas" name="public" domain="[('website_published','=',True)]"/>
                <filter string="Por Finalidade" name="group_purpose" context="{'group_by':'purpose'}"/>
                <filter string="Por Categoria" name="group_category" context="{'group_by':'category_id'}"/>
                <filter string="Por Imóvel" name="group_asset" context="{'group_by':'asset_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_property_media" model="ir.actions.act_window">
        <field name="name">Mídias e Fotos</field>
        <field name="res_model">property.media</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_group_purpose': 1}</field>
    </record>

    <record id="action_property_media_site_review" model="ir.actions.act_window">
        <field name="name">Revisão para Site</field>
        <field name="res_model">property.media</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('purpose','=','asset_gallery')]</field>
        <field name="context">{'search_default_group_asset': 1}</field>
    </record>
</odoo>
