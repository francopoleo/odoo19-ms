<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_stakeholder_type_list" model="ir.ui.view">
        <field name="name">property.stakeholder.type.list</field><field name="model">property.stakeholder.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="category_group"/>
                <field name="default_partner_tag_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_property_stakeholder_type_form" model="ir.ui.view">
        <field name="name">property.stakeholder.type.form</field><field name="model">property.stakeholder.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/><field name="code"/><field name="category_group"/><field name="sequence"/><field name="active"/>
                        </group>
                        <group>
                            <field name="default_partner_tag_id"/><field name="is_person_role"/><field name="is_company_role"/><field name="can_receive_commission"/><field name="can_have_portal_access"/><field name="can_be_website_actor"/>
                        </group>
                    </group>
                    <group string="Descrição"><field name="description" nolabel="1"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_property_stakeholder_type" model="ir.actions.act_window">
        <field name="name">Tipos de Perfil Imobiliário</field><field name="res_model">property.stakeholder.type</field><field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Defina os papéis imobiliários que poderão ser atribuídos aos contatos.</p>
            <p>Exemplos: proprietário, locatário, corretor, comprador, vendedor e investidor.</p>
        </field>
    </record>
</odoo>