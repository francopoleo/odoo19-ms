<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== LIST ==================== -->
    <record id="view_property_broker_assignment_list" model="ir.ui.view">
        <field name="name">property.broker.assignment.list</field>
        <field name="model">property.broker.assignment</field>
        <field name="arch" type="xml">
            <list decoration-success="status == 'converted'"
                  decoration-muted="status in ('expired','cancelled')"
                  decoration-info="status == 'active'">
                <field name="reference"/>
                <field name="broker_id"/>
                <field name="asset_id"/>
                <field name="assignment_type" widget="badge"
                       decoration-primary="assignment_type == 'sale'"
                       decoration-info="assignment_type == 'rental'"
                       decoration-warning="assignment_type == 'both'"/>
                <field name="exclusive" widget="boolean_toggle"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="contract_id"/>
                <field name="status" widget="badge"
                       decoration-info="status == 'active'"
                       decoration-success="status == 'converted'"
                       decoration-muted="status in ('expired','cancelled')"/>
            </list>
        </field>
    </record>

    <!-- ==================== FORM ==================== -->
    <record id="view_property_broker_assignment_form" model="ir.ui.view">
        <field name="name">property.broker.assignment.form</field>
        <field name="model">property.broker.assignment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_cancel" type="object"
                            string="Cancelar Mandato"
                            invisible="status in ('cancelled','converted','expired')"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="active,converted,expired,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>

                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <div class="o_row">
                            <field name="reference" readonly="1" class="text-muted"/>
                        </div>
                    </div>

                    <group>
                        <group string="Partes">
                            <field name="broker_id"/>
                            <field name="asset_id"/>
                        </group>
                        <group string="Mandato">
                            <field name="assignment_type"/>
                            <field name="exclusive"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>

                    <group string="Resultado" invisible="status not in ['converted']">
                        <group>
                            <field name="contract_id" readonly="1"/>
                            <field name="commission_id" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <field name="notes" placeholder="Observações sobre este mandato..."/>
                    </group>

                    <notebook>
                        <page string="Comunicações">
                            <chatter/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ==================== SEARCH ==================== -->
    <record id="view_property_broker_assignment_search" model="ir.ui.view">
        <field name="name">property.broker.assignment.search</field>
        <field name="model">property.broker.assignment</field>
        <field name="arch" type="xml">
            <search>
                <field name="broker_id"/>
                <field name="asset_id"/>
                <field name="reference"/>
                <filter string="Ativos" name="active" domain="[('status','=','active')]"/>
                <filter string="Exclusivos" name="exclusive" domain="[('exclusive','=',True)]"/>
                <filter string="Convertidos" name="converted" domain="[('status','=','converted')]"/>
                <filter string="Expirados" name="expired" domain="[('status','=','expired')]"/>
                <separator/>
                <filter string="Locação" name="rental" domain="[('assignment_type','in',['rental','both'])]"/>
                <filter string="Venda" name="sale" domain="[('assignment_type','in',['sale','both'])]"/>
                <separator/>
                <filter string="Por Corretor" name="group_broker" context="{'group_by':'broker_id'}"/>
                <filter string="Por Imóvel" name="group_asset" context="{'group_by':'asset_id'}"/>
                <filter string="Por Tipo" name="group_type" context="{'group_by':'assignment_type'}"/>
            </search>
        </field>
    </record>

    <!-- ==================== ACTION ==================== -->
    <record id="action_property_broker_assignment" model="ir.actions.act_window">
        <field name="name">Mandatos</field>
        <field name="res_model">property.broker.assignment</field>
        <field name="view_mode">list,form</field>
        <field name="context">{"search_default_active": 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nenhum mandato registrado ainda.</p>
        </field>
    </record>

</odoo>